  "id": "1FC614",
  "jp": "先ほどアークエイルで\nプレジャーとエディルレイドを\nねらった事件の話をききました。",
  "en": null,
  "slots": [
   "5E38CC"
  ]
 },
 {
  "id": "1FC5CC",
  "jp": "見た、としか情報がなく\nねらわれた本人たちからの\n情報がないんですが…",
  "en": null,
  "slots": [
   "5E38F0"
  ]
 },
 {
  "id": "1FC588",
  "jp": "どうやらその事件に\nクーさんとレンさんは\nまきこまれたようですね。",
  "en": null,
  "slots": [
   "5E3914"
  ]
 },
 {
  "id": "1FC538",
  "jp": "おそいかかってきた敵は、\nレンさんがエディルレイドだと\n知っていたのですか？",
  "en": null,
  "slots": [
   "5E3938"
  ]
 },
 {
  "id": "1FC530",
  "jp": "え……",
  "en": null,
  "slots": [
   "5E395C"
  ]
 },
 {
  "id": "1FC520",
  "jp": "もしかして…",
  "en": null,
  "slots": [
   "5E3980"
  ]
 },
 {
  "id": "1FC4F0",
  "jp": "誰かにエディルレイドだと\nしゃべった…とか…",
  "en": null,
  "slots": [
   "5E39A4"
  ]
 },
 {
  "id": "1FC4C0",
  "jp": "街に入る前にあの子から\n言われてたでしょう？",
  "en": null,
  "slots": [
   "5E39C8"
  ]
 },
 {
  "id": "1FC4B0",
  "jp": "そう…だけど…",
