  "slots": [
   "5E3038"
  ]
 },
 {
  "id": "1FCE0C",
  "jp": "人とエディルレイドが\n共に生きていられる明日など\nありはしないのだ。",
  "en": null,
  "slots": [
   "5E305C"
  ]
 },
 {
  "id": "1FCDE0",
  "jp": "われわれが正しい道へ\nみちびいてやろう。",
