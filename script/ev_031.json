[
 {
  "id": "22C628",
  "jp": "何のために、エディルレイドを\n連れさったんだ？",
  "en": null,
  "slots": [
   "624B64"
  ]
 },
 {
  "id": "22C60C",
  "jp": "商人に教会まではこばせて…",
  "en": null,
  "slots": [
   "624B88"
  ]
 },
 {
  "id": "22C5B4",
  "jp": "あの子に、はこんでもらったのは\nアークエイルに見つからない\nようにするためなんです。",
  "en": null,
  "slots": [
   "624BAC"
  ]
 },
 {
  "id": "22C56C",
  "jp": "この街から出してしまえば\n探し出すのもむずかしくなる\nだろうし、と。",
  "en": null,
  "slots": [
   "624BD0"
  ]
 },
 {
  "id": "22C520",
  "jp": "教会のことも、みなさん\n忘れてしまっていたようなので\n使うことにしました。",
  "en": null,
  "slots": [
   "624BF4"
  ]
 },
 {
  "id": "22C4F4",
  "jp": "それは、神父ももちろん\n知ってたんだよな？",
  "en": null,
  "slots": [
   "624C18"
  ]
 },
 {
  "id": "22C4E8",
  "jp": "え…ええ。",
  "en": null,
  "slots": [
   "624C3C"
  ]
 },
 {
  "id": "22C4B4",
  "jp": "『教会の地下に入れれば\n　レーダーにうつらない』",
  "en": null,
  "slots": [
   "624C60"
  ]
 },
 {
  "id": "22C498",
  "jp": "そう、教えて下さいました。",
  "en": null,
  "slots": [
   "624C84"
  ]
 },
 {
  "id": "22C45C",
  "jp": "それで、エディルレイドたちを\nどうするつもりだったんだ？",
  "en": null,
  "slots": [
   "624CA8"
  ]
 },
 {
  "id": "22C440",
  "jp": "まさか…売るつもりじゃ…",
  "en": null,
  "slots": [
   "624CCC"
  ]
 },
 {
  "id": "22C424",
  "jp": "そんなことはありません！",
  "en": null,
  "slots": [
   "624CF0"
  ]
 },
 {
  "id": "22C408",
  "jp": "謳が…ほしかったんです。",
  "en": null,
  "slots": [
   "624D14"
  ]
 },
 {
  "id": "22C3CC",
  "jp": "みなさん、カールセンの家の\n事故は知ってるかと思います。",
  "en": null,
  "slots": [
   "624D38"
  ]
 },
 {
  "id": "22C3A4",
  "jp": "あの事故からカールセンは\n眠ったまま…",
  "en": null,
  "slots": [
   "624D5C"
  ]
 },
 {
  "id": "22C37C",
  "jp": "私、どうしたらいいか\nわからなくて。",
  "en": null,
  "slots": [
   "624D80"
  ]
 },
 {
  "id": "22C334",
  "jp": "そしたら神父さまが\n『めざめの謳』をうたえる\nエディルレイドを探せと。",
  "en": null,
  "slots": [
   "624DA4"
  ]
 },
 {
  "id": "22C2E8",
  "jp": "謳をうたわせるだけなら\n何もとっつかまえなくっても\nよかったんじゃない？",
  "en": null,
  "slots": [
   "624DC8"
  ]
 },
 {
  "id": "22C2D4",
  "jp": "そうなんですが…",
  "en": null,
  "slots": [
   "624DEC"
  ]
 },
 {
  "id": "22C284",
  "jp": "説明は後ですればいい、と。\nプレジャーさんたちは\nブレイブスアルカにいますし。",
  "en": null,
  "slots": [
   "624E10"
  ]
 },
 {
  "id": "22C270",
  "jp": "『あやつりの謳』。",
  "en": null,
  "slots": [
   "624E34"
  ]
 },
 {
  "id": "22C244",
  "jp": "あれをうたったのは、\nアンタだったのね。",
  "en": null,
  "slots": [
   "624E58"
  ]
 },
 {
  "id": "22C230",
  "jp": "『忘却の謳』も？",
  "en": null,
  "slots": [
   "624EA0"
  ]
 },
 {
  "id": "22C224",
  "jp": "そうです。",
  "en": null,
  "slots": [
   "624EC4"
  ]
 },
 {
  "id": "22C1D4",
  "jp": "何の話し合いも無く、無理矢理\nおそいかかったので、ほとんど\n戦いになりました。",
  "en": null,
  "slots": [
   "624EE8"
  ]
 },
 {
  "id": "22C1A4",
  "jp": "謳を忘れさせた後では\nすぐに謳がうたえないので",
  "en": null,
  "slots": [
   "624F0C"
  ]
 },
 {
  "id": "22C15C",
  "jp": "その時間かせぎのために\n教会に、エディルレイドたちを\nかくしました。",
  "en": null,
  "slots": [
   "624F30"
  ]
 },
 {
  "id": "22C150",
  "jp": "それで？",
  "en": null,
  "slots": [
   "624F54"
  ]
 },
 {
  "id": "22C120",
  "jp": "『めざめの謳』をうたえた\nエディルレイドは？",
  "en": null,
  "slots": [
   "624F78"
  ]
 },
 {
  "id": "22C0EC",
  "jp": "七煌宝樹であるレンさんなら\nきっとうたえる、と。",
  "en": null,
  "slots": [
   "624F9C"
  ]
 },
 {
  "id": "22C0E4",
  "jp": "私？",
  "en": null,
  "slots": [
   "624FC0"
  ]
 },
 {
  "id": "22C0A4",
  "jp": "お願いです！\n何も言わずに、カールのために\nうたって下さい！",
  "en": null,
  "slots": [
   "624FE4"
  ]
 },
 {
  "id": "22C058",
  "jp": "いいえ…うたって下さらないと\nおっしゃるなら…\n私の『あやつりの謳』で！",
  "en": null,
  "slots": [
   "625008"
  ]
 },
 {
  "id": "22C044",
  "jp": "…うたえないわ。",
  "en": null,
  "slots": [
   "62502C"
  ]
 },
 {
  "id": "22C028",
  "jp": "レンさん…\nじゃあ…私は…",
  "en": null,
  "slots": [
   "625050"
  ]
 },
 {
  "id": "22C000",
  "jp": "だって、私、そんな謳\n知らないもの。",
  "en": null,
  "slots": [
   "625074"
  ]
 },
 {
  "id": "22BFD8",
  "jp": "それじゃあ、誰が\nうたえるんですか！？",
  "en": null,
  "slots": [
   "6250BC"
  ]
 },
 {
  "id": "22BF7C",
  "jp": "何人も、何人もエディルレイドの\n泣きさけぶ声をきいてきたのに…\nまだ、見つからないなんて…",
  "en": null,
  "slots": [
   "6250E0"
  ]
 },
 {
  "id": "22BF70",
  "jp": "エンダ…",
  "en": null,
  "slots": [
   "625104"
  ]
 },
 {
  "id": "22BF2C",
  "jp": "キーアは、何か知らない？\n前に、同じ様なことがあったー\nとか、さ。",
  "en": null,
  "slots": [
   "625128"
  ]
 },
 {
  "id": "22BF14",
  "jp": "あたしも知らないわ。",
  "en": null,
  "slots": [
   "62514C"
  ]
 },
 {
  "id": "22BF08",
  "jp": "う～ん…",
  "en": null,
  "slots": [
   "625170"
  ]
 },
 {
  "id": "22BED8",
  "jp": "でも、何かあるはずだわ。\n彼を起こす方法が。",
  "en": null,
  "slots": [
   "625194"
  ]
 },
 {
  "id": "22BEA8",
  "jp": "だから、それまで\nあなたが彼を守ってあげるの。",
  "en": null,
  "slots": [
   "6251B8"
  ]
 },
 {
  "id": "22BE70",
  "jp": "エディルレイドにとって\nそんなに長い時間じゃないわ。",
  "en": null,
  "slots": [
   "6251DC"
  ]
 },
 {
  "id": "22BE5C",
  "jp": "ええ…そうですね。",
  "en": null,
  "slots": [
   "625200"
  ]
 },
 {
  "id": "22BE3C",
  "jp": "カールセンのこと\nなんだけど…",
  "en": null,
  "slots": [
   "625224"
  ]
 },
 {
  "id": "22BE20",
  "jp": "事故って何があったんだ？",
  "en": null,
  "slots": [
   "625248"
  ]
 },
 {
  "id": "22BE18",
  "jp": "私が…",
  "en": null,
  "slots": [
   "62526C"
  ]
 },
 {
  "id": "22BDE8",
  "jp": "私がカールに無理矢理\nリアクトしてしまったの。",
  "en": null,
  "slots": [
   "625290"
  ]
 },
 {
  "id": "22BDB8",
  "jp": "そしたら、カールが\nさけびはじめてしまって…",
  "en": null,
  "slots": [
   "6252B4"
  ]
 },
 {
  "id": "22BD74",
  "jp": "気がついたときには\nリアクトはとけていて、\n家が、こわれていた…",
  "en": null,
  "slots": [
   "6252D8"
  ]
 },
 {
  "id": "22BD34",
  "jp": "カールがたおれていて、\nカールのお父さまが\nいなくなっていた。",
  "en": null,
  "slots": [
   "6252FC"
  ]
 },
 {
  "id": "22BCE0",
  "jp": "私は、人の記憶を消し、\nあやつる謳しかうたえない\n危険なエディルレイドなんです。",
  "en": null,
  "slots": [
   "625320"
  ]
 },
 {
  "id": "22BC88",
  "jp": "リアクトしたプレジャーを\nこわしてしまうエディルレイド\nなんて、きいたことがないわ！",
  "en": null,
  "slots": [
   "625344"
  ]
 },
 {
  "id": "22BC3C",
  "jp": "はじめてのリアクトで\n力をうまく、コントロール\nできる人なんか、いないわ。",
  "en": null,
  "slots": [
   "625368"
  ]
 },
 {
  "id": "22BBF8",
  "jp": "あなたは記憶や気持ちを\n謳でコントロールする\n力を持っているから",
  "en": null,
  "slots": [
   "62538C"
  ]
 },
 {
  "id": "22BBA4",
  "jp": "はじめてのことで、\nプレジャーがあせってしまって\n力が悪い方に、はたらいただけ。",
  "en": null,
  "slots": [
   "6253B0"
  ]
 },
 {
  "id": "22BB80",
  "jp": "あなた一人の\n力の問題じゃないわ。",
  "en": null,
  "slots": [
   "6253D4"
  ]
 },
 {
  "id": "22BB74",
  "jp": "それでも…",
  "en": null,
  "slots": [
   "6253F8"
  ]
 },
 {
  "id": "22BB5C",
  "jp": "カールは眠ったまま…",
  "en": null,
  "slots": [
   "62541C"
  ]
 },
 {
  "id": "22BB14",
  "jp": "事故のことを、もっと\nくわしくうかがえば\n何とかなるかもしれません。",
  "en": null,
  "slots": [
   "625440"
  ]
 },
 {
  "id": "22BB04",
  "jp": "本当ですか！？",
  "en": null,
  "slots": [
   "625464"
  ]
 },
 {
  "id": "22BAC0",
  "jp": "カールセンさんが\n眠ったままなのは\nエンダさんの力のためでしょう。",
  "en": null,
  "slots": [
   "625488"
  ]
 },
 {
  "id": "22BA78",
  "jp": "事故のときに、いったい\nどんな力がカールセンさんに\nはたらいたのか。",
  "en": null,
  "slots": [
   "6254AC"
  ]
 },
 {
  "id": "22BA64",
  "jp": "それさえわかれば…",
  "en": null,
  "slots": [
   "6254D0"
  ]
 },
 {
  "id": "22BA54",
  "jp": "そう…ですか。",
  "en": null,
  "slots": [
   "6254F4"
  ]
 },
 {
  "id": "22BA34",
  "jp": "まだ、のぞみはあるんですね。",
  "en": null,
  "slots": [
   "625518"
  ]
 },
 {
  "id": "22B9F0",
  "jp": "ブレイブスアルカを使って\nエディルレイドプレジャーを\nおそってた。",
  "en": null,
  "slots": [
   "62553C"
  ]
 },
 {
  "id": "22B9C8",
  "jp": "それを、エンダは\nどう思ってたんだ？",
  "en": null,
  "slots": [
   "625560"
  ]
 },
 {
  "id": "22B99C",
  "jp": "私…自分のことしか\n考えていませんでした。",
  "en": null,
  "slots": [
   "6255A8"
  ]
 },
 {
  "id": "22B94C",
  "jp": "私は眠ったままのカールを\n見ることしかできないのに\nほかのエディルレイドたちは",
  "en": null,
  "slots": [
   "6255CC"
  ]
 },
 {
  "id": "22B90C",
  "jp": "プレジャーと、楽しそうに\n話をしたり、幸せそうに\nわらったり…",
  "en": null,
  "slots": [
   "6255F0"
  ]
 },
 {
  "id": "22B8EC",
  "jp": "その幸せを、こわしてやろう。",
  "en": null,
  "slots": [
   "625614"
  ]
 },
 {
  "id": "22B8B8",
  "jp": "…そう考えていたのは…\n私の本当の気持ちでした。",
  "en": null,
  "slots": [
   "625638"
  ]
 },
 {
  "id": "22B8A8",
  "jp": "エンダさん…",
  "en": null,
  "slots": [
   "62565C"
  ]
 },
 {
  "id": "22B880",
  "jp": "今もそう思って\nいらっしゃるんですか？",
  "en": null,
  "slots": [
   "625680"
  ]
 },
 {
  "id": "22B834",
  "jp": "カールの目がさめないかぎり…\n私は…プレジャーのいる\nエディルレイドたちを",
  "en": null,
  "slots": [
   "6256C8"
  ]
 },
 {
  "id": "22B810",
  "jp": "にくんでしまうかも\nしれません…",
  "en": null,
  "slots": [
   "6256EC"
  ]
 },
 {
  "id": "22B7C4",
  "jp": "ですが、もう、謳を忘れさせたり\nなどということはしません。\n約束します。",
  "en": null,
  "slots": [
   "625710"
  ]
 },
 {
  "id": "22B784",
  "jp": "まったく、こっちは\n街中でおそわれて\nたいへんだったんだぜ。",
  "en": null,
  "slots": [
   "625734"
  ]
 },
 {
  "id": "22B774",
  "jp": "すみません。",
  "en": null,
  "slots": [
   "625758"
  ]
 },
 {
  "id": "22B72C",
  "jp": "後は、教会にいる\nエディルレイドを助けて\nプレジャーと会わせること。",
  "en": null,
  "slots": [
   "6257A0"
  ]
 },
 {
  "id": "22B6EC",
  "jp": "エンダさんには、\nアークエイルで事情を\n説明していただきます。",
  "en": null,
  "slots": [
   "6257C4"
  ]
 },
 {
  "id": "22B6D4",
  "jp": "はい。\nわかりました。",
  "en": null,
  "slots": [
   "6257E8"
  ]
 },
 {
  "id": "22B690",
  "jp": "それから、あの神父サマにも\nお話をうかがわなくては\nいけませんね…",
  "en": null,
  "slots": [
   "62580C"
  ]
 },
 {
  "id": "22B66C",
  "jp": "すぐにアークエイルに\n報告です！",
  "en": null,
  "slots": [
   "625830"
  ]
 },
 {
  "id": "22B618",
  "jp": "『エディルレイド連れさり事件』\nシスカ保護官の手によって\nイッケンラクチャク！！",
  "en": null,
  "slots": [
   "625854"
  ]
 },
 {
  "id": "22B604",
  "jp": "一人で言ってろヨ…",
  "en": null,
  "slots": [
   "6258C0"
  ]
 },
 {
  "id": "22B5E8",
  "jp": "オーホッホッホッホッホ！",
  "en": null,
  "slots": [
   "6258E4"
  ]
 },
