  "slots": [
   "61EF48"
  ]
 },
 {
  "id": "22725C",
  "jp": "少しだけ、\nエンダさんをさけます。",
  "en": null,
  "slots": [
   "61EF6C"
  ]
 },
 {
  "id": "227250",
  "jp": "しかし…",
  "en": null,
  "slots": [
   "61EF90"
  ]
 },
 {
  "id": "227218",
  "jp": "エディルレイドだと知っても\nそれまですごした同じ時間は",
  "en": null,
  "slots": [
   "61EFB4"
  ]
 },
 {
  "id": "2271F4",
