  "en": null,
  "slots": [
   "61F044"
  ]
 },
 {
  "id": "227174",
  "jp": "それがいいんですよ～。",
  "en": null,
  "slots": [
   "61F068"
  ]
 },
 {
  "id": "22714C",
  "jp": "しかし、二人はそのまま\n大きくなって…",
