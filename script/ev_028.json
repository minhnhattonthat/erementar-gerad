  "en": null,
  "slots": [
   "61EFD8"
  ]
 },
 {
  "id": "2271A8",
  "jp": "カールセンさんは、再び\nエンダさんと同じ時間を\nすごすようになるのです。",
  "en": null,
  "slots": [
   "61EFFC"
  ]
 },
 {
  "id": "22718C",
