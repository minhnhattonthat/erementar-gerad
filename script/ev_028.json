  "slots": [
   "61F0F8"
  ]
 },
 {
  "id": "2270B8",
  "jp": "エンダさんは、カールセンさんを\n愛しはじめたんですね。",
  "en": null,
  "slots": [
   "61F11C"
  ]
 },
 {
  "id": "22705C",
  "jp": "そのとき、自分がエディルレイド\nだってことで、カールセンさんを\nさけるようになってしまう。",
  "en": null,
  "slots": [
   "61F140"
  ]
 },
 {
  "id": "227024",
