  "slots": [
   "5FB068"
  ]
 },
 {
  "id": "212028",
  "jp": "おかみさんに、\n先に行くってことを\n伝えてもらっておこうか。",
  "en": null,
  "slots": [
   "5FB08C"
  ]
 },
 {
  "id": "21201C",
