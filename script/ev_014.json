  ]
 },
 {
  "id": "211F9C",
  "jp": "俺たち、街の中を先に\nうろつくからって\n伝えといてほしくて。",
  "en": null,
  "slots": [
   "5FB164"
  ]
 },
 {
  "id": "211F90",
  "jp": "あいよ。",
  "en": null,
  "slots": [
   "5FB188"
  ]
 },
 {
  "id": "211F54",
