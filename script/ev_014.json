 },
 {
  "id": "20F174",
  "jp": "よかったら、僕たちが\nきいてあげるから。",
  "en": null,
  "slots": [
   "5FA594"
  ]
 },
 {
  "id": "20F148",
  "jp": "う…いいのヨ…たいしたことじゃ\nないのヨ…",
  "en": null,
  "slots": [
   "5FA5B8"
  ]
 },
 {
  "id": "20F11C",
  "jp": "アタシの気のせいかも\nしれないんだから。",
  "en": null,
  "slots": [
   "5FA5DC"
  ]
 },
 {
  "id": "20F110",
  "jp": "気のせい？",
  "en": null,
  "slots": [
   "5FA600"
  ]
 },
 {
  "id": "20F104",
  "jp": "昨日ね！",
  "en": null,
  "slots": [
   "5FA624"
  ]
 },
 {
  "id": "20F0DC",
  "jp": "昨日…ヴォル君がアタシに\n言ったのヨ。",
  "en": null,
  "slots": [
   "5FA648"
  ]
 },
 {
  "id": "20F0C8",
  "jp": "『待ってろ』って。",
  "en": null,
  "slots": [
   "5FA66C"
  ]
 },
 {
  "id": "20F0BC",
  "jp": "彼が……",
  "en": null,
  "slots": [
   "5FA690"
  ]
 },
 {
  "id": "20F0A0",
  "jp": "そう言ったのかい？　君に？",
  "en": null,
  "slots": [
   "5FA6B4"
  ]
 },
 {
  "id": "20F074",
  "jp": "それって、もうあやつられて\nないってこと？",
  "en": null,
  "slots": [
   "5FA6D8"
  ]
 },
 {
  "id": "20F048",
  "jp": "だったら、どうして\n逃げたんでしょうか。",
  "en": null,
  "slots": [
   "5FA6FC"
  ]
 },
 {
  "id": "20F018",
  "jp": "アークエイルには\nつかまっていませんでしたし…",
  "en": null,
  "slots": [
   "5FA720"
  ]
 },
 {
  "id": "20EFE0",
  "jp": "黒集団といっしょにいて\n何かしようと…たくらんでる…？",
  "en": null,
  "slots": [
   "5FA744"
  ]
 },
 {
  "id": "20EFCC",
  "jp": "たしかめたいのヨ！",
  "en": null,
  "slots": [
   "5FA768"
  ]
 },
 {
  "id": "20EFA8",
  "jp": "ヴォル君、きっと何か\nしらべてて…",
  "en": null,
  "slots": [
   "5FA78C"
  ]
 },
 {
  "id": "20EF68",
  "jp": "ヤツらのアジトとか…\nエディルレイドが\nどこにいるのか、とか…",
  "en": null,
  "slots": [
   "5FA7B0"
  ]
 },
 {
  "id": "20EF4C",
  "jp": "そうにちがいないのヨ！！",
  "en": null,
  "slots": [
   "5FA7D4"
  ]
 },
 {
  "id": "20EF30",
  "jp": "黒集団を、中からしらべる…",
  "en": null,
  "slots": [
   "5FA7F8"
  ]
 },
 {
  "id": "20EEDC",
  "jp": "その目的は、彼らがとらえた\nエディルレイドを、よこどり\nすることかもしれませんよ。",
  "en": null,
  "slots": [
   "5FA81C"
  ]
 },
 {
  "id": "20EEB4",
  "jp": "彼はエディルレイドハンター\nですから。",
  "en": null,
  "slots": [
   "5FA840"
  ]
 },
 {
  "id": "20EEAC",
  "jp": "え……",
  "en": null,
  "slots": [
   "5FA864"
  ]
 },
 {
  "id": "20EEA0",
  "jp": "シスカ！",
  "en": null,
  "slots": [
   "5FA888"
  ]
 },
 {
  "id": "20EE8C",
  "jp": "可能性の話です。",
  "en": null,
  "slots": [
   "5FA8AC"
  ]
 },
 {
  "id": "20EE48",
  "jp": "とりあえず、彼にかかった\nあやつりの謳の力は\n消えているとして、",
  "en": null,
  "slots": [
   "5FA8D0"
  ]
 },
 {
  "id": "20EE1C",
  "jp": "ブレイブスアルカを\nしらべるのが先です。",
  "en": null,
  "slots": [
   "5FA8F4"
  ]
 },
 {
  "id": "20EDF0",
  "jp": "ふっかつしたと思ったら\nすぐこれだもん…",
  "en": null,
  "slots": [
   "5FA918"
  ]
 },
 {
  "id": "20EDBC",
  "jp": "はね橋がおりていたら\nすぐにでも闘技場地下へ行って",
  "en": null,
  "slots": [
   "5FA93C"
  ]
 },
 {
  "id": "20ED70",
  "jp": "セキニンシャの首ねっこを\nひっつかまえて、ギュウっと\nしめ上げてやります！",
  "en": null,
  "slots": [
   "5FA960"
  ]
 },
 {
  "id": "20ED64",
  "jp": "チルル…",
  "en": null,
  "slots": [
   "5FA9A8"
  ]
 },
 {
  "id": "20ED34",
  "jp": "おい、シスカー。\nさっきのはマズイんじゃねぇ？",
  "en": null,
  "slots": [
   "5FA9CC"
  ]
 },
 {
  "id": "20ED00",
  "jp": "もうちょっと、何か\n言い方ってもんが、あるだろ？",
  "en": null,
  "slots": [
   "5FA9F0"
  ]
 },
 {
  "id": "20ECE0",
  "jp": "さっき？　さっきって何です？",
  "en": null,
  "slots": [
   "5FAA14"
  ]
 },
 {
  "id": "20EC88",
  "jp": "ヴォルクスが、エディルレイド\nねらって、まだヤツらんトコに\nいるって言ってたじゃん。",
  "en": null,
  "slots": [
   "5FAA38"
  ]
 },
 {
  "id": "20EC3C",
  "jp": "あいつ…心配してんのにさ\nもうちょっとやさしい言葉とか\nかけてやれねぇか？",
  "en": null,
  "slots": [
   "5FAA5C"
  ]
 },
 {
  "id": "20EBF8",
  "jp": "クーさんにそんなことを言われる\nなんて…私、そんなに\n悪人ですか？",
  "en": null,
  "slots": [
   "5FAAA4"
  ]
 },
 {
  "id": "20EBD8",
  "jp": "私、これでも信じてるんですよ。",
  "en": null,
  "slots": [
   "5FAAC8"
  ]
 },
 {
  "id": "20EB80",
  "jp": "あのエディルレイドハンターは\nどんなかたちでもエディルレイド\nを連れもどして来るって。",
  "en": null,
  "slots": [
   "5FAAEC"
  ]
 },
 {
  "id": "20EB2C",
  "jp": "人にいいように使われるだけ\n使われるなんて、あの人が\nがまんできないでしょうし？",
  "en": null,
  "slots": [
   "5FAB10"
  ]
 },
 {
  "id": "20EB24",
  "jp": "へぇ。",
  "en": null,
  "slots": [
   "5FAB34"
  ]
 },
 {
  "id": "20EAF8",
  "jp": "えらく信じてるんだな。\nあのハンターを。",
  "en": null,
  "slots": [
   "5FAB58"
  ]
 },
 {
  "id": "20EAE0",
  "jp": "信じてるというより…",
  "en": null,
  "slots": [
   "5FAB7C"
  ]
 },
 {
  "id": "20EA88",
  "jp": "それくらい気合い入れて\nやってもらわなきゃ、こっちも\nはり合いがないってだけですよ。",
  "en": null,
  "slots": [
   "5FABA0"
  ]
 },
 {
  "id": "20EA54",
  "jp": "クーさんも、気合い入れて\nがんばって下さいネッ！",
  "en": null,
  "slots": [
   "5FABC4"
  ]
 },
 {
  "id": "20EA44",
  "jp": "…いってぇ…",
  "en": null,
  "slots": [
   "5FAC0C"
  ]
 },
 {
  "id": "21232C",
  "jp": "ねぇ、ちょっと待っててよ。",
  "en": null,
  "slots": [
   "5FAC54"
  ]
 },
 {
  "id": "2122F8",
  "jp": "朝、寝ぼうしちゃって\nシャワーあびてないのよね。",
  "en": null,
  "slots": [
   "5FAC9C"
  ]
 },
 {
  "id": "2122C8",
  "jp": "やっぱ気持ち悪いから\nあびて行きたいんだけど。",
