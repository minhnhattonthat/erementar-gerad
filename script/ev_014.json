[
 {
  "id": "20E544",
  "jp": "何だ。",
  "en": null,
  "slots": [
   "5F91C0"
  ]
 },
 {
  "id": "20E528",
  "jp": "けっこうイイヤツじゃん。",
  "en": null,
  "slots": [
   "5F91E4"
  ]
 },
 {
  "id": "20E4E0",
  "jp": "私が言ってた通りでしょ？\nど～んと大船に乗ったつもりで\nいなさいッテ！",
  "en": null,
  "slots": [
   "5F9208"
  ]
 },
 {
  "id": "20E4D0",
  "jp": "言ってない。",
  "en": null,
  "slots": [
   "5F922C"
  ]
 },
 {
  "id": "20E4C8",
  "jp": "うッ。",
  "en": null,
  "slots": [
   "5F9250"
  ]
 },
 {
  "id": "20E49C",
  "jp": "………さ、さあ\n行きましょう、ね？　ね？",
  "en": null,
  "slots": [
   "5F9274"
  ]
 },
 {
  "id": "20E488",
  "jp": "何ですか、ここは…",
  "en": null,
  "slots": [
   "5F92E0"
  ]
 },
 {
  "id": "20E480",
  "jp": "しっ。",
  "en": null,
  "slots": [
   "5F9304"
  ]
 },
 {
  "id": "20E450",
  "jp": "質問と関係無いことは\nあまり話さないように。",
  "en": null,
  "slots": [
   "5F9328"
  ]
 },
 {
  "id": "20E440",
  "jp": "いいですね。",
  "en": null,
  "slots": [
   "5F934C"
  ]
 },
 {
  "id": "20E430",
  "jp": "は……ハイ…",
  "en": null,
  "slots": [
   "5F9370"
  ]
 },
 {
  "id": "20E420",
  "jp": "では、質問を。",
  "en": null,
  "slots": [
   "5F9394"
  ]
 },
 {
  "id": "20E3E8",
  "jp": "あまり長くならないように。\n手みじかにお願いします。",
  "en": null,
  "slots": [
   "5F93B8"
  ]
 },
 {
  "id": "20E3CC",
  "jp": "な、何からききましょうか…",
  "en": null,
  "slots": [
   "5F9400"
  ]
 },
 {
  "id": "20E384",
  "jp": "先輩、おちついて。\n僕がいくつか考えておいたので\nよかったらこれを…",
  "en": null,
  "slots": [
   "5F9424"
  ]
 },
 {
  "id": "20E36C",
  "jp": "どれです？　何なに…？",
  "en": null,
  "slots": [
   "5F9448"
  ]
 },
 {
  "id": "20E340",
  "jp": "ああ、ダメです。\nキンチョーしてしまって。",
  "en": null,
  "slots": [
   "5F9490"
  ]
 },
 {
  "id": "20E320",
  "jp": "クーさん、後はたのみました…",
  "en": null,
  "slots": [
   "5F94B4"
  ]
 },
 {
  "id": "20E30C",
  "jp": "ええっ！？　俺？",
  "en": null,
  "slots": [
   "5F94D8"
  ]
 },
 {
  "id": "20E2F8",
  "jp": "ここからえらぶの？",
  "en": null,
  "slots": [
   "5F94FC"
  ]
 },
 {
  "id": "20E2EC",
  "jp": "…そうか…",
  "en": null,
  "slots": [
   "5F9520"
  ]
 },
 {
  "id": "20E2C8",
  "jp": "クー、つぎは何を\n質問するんだい？",
  "en": null,
  "slots": [
   "5F9544"
  ]
 },
 {
  "id": "20E2BC",
  "jp": "えっと…",
  "en": null,
  "slots": [
   "5F9568"
  ]
 },
 {
  "id": "20E2B0",
  "jp": "時間です。",
  "en": null,
  "slots": [
   "5F958C"
  ]
 },
 {
  "id": "20E290",
  "jp": "ここまでにしてもらいましょう。",
  "en": null,
  "slots": [
   "5F95B0"
  ]
 },
 {
  "id": "20E260",
  "jp": "後はわれわれにまかせて\n宿へもどって下さい。",
  "en": null,
  "slots": [
   "5F95D4"
  ]
 },
 {
  "id": "20E254",
  "jp": "集団の正体",
  "en": null,
  "slots": [
   "5F95F8"
  ]
 },
 {
  "id": "20E248",
  "jp": "集団の目的",
  "en": null,
  "slots": [
   "5F961C"
  ]
 },
 {
  "id": "20E238",
  "jp": "人をあやつる謳",
  "en": null,
  "slots": [
   "5F9640"
  ]
 },
 {
  "id": "20E220",
  "jp": "わかった。これだね。",
  "en": null,
  "slots": [
   "5F9664"
  ]
 },
 {
  "id": "20E1F8",
  "jp": "これから質問することに\n答えるように。",
  "en": null,
  "slots": [
   "5F9688",
   "5F9814",
   "5F9A54"
  ]
 },
 {
  "id": "20E1EC",
  "jp": "あ、ああ…",
  "en": null,
  "slots": [
   "5F96AC"
  ]
 },
 {
  "id": "20E1C0",
  "jp": "君たちの集団には、何か\n名前があるのか？",
  "en": null,
  "slots": [
   "5F96D0"
  ]
 },
 {
  "id": "20E194",
  "jp": "『ブレイブスアルカ』という\n名前がある。",
  "en": null,
  "slots": [
   "5F9718"
  ]
 },
 {
  "id": "20E158",
  "jp": "その『ブレイブスアルカ』は\nいつも、ああやって集団になり",
  "en": null,
  "slots": [
   "5F973C"
  ]
 },
 {
  "id": "20E12C",
  "jp": "エディルレイドプレジャーを\nおそうのか？",
  "en": null,
  "slots": [
   "5F9760"
  ]
 },
 {
  "id": "20E120",
  "jp": "おそう…？",
  "en": null,
  "slots": [
   "5F9784"
  ]
 },
 {
  "id": "20E0D4",
  "jp": "人間やエディルレイドが\n不幸にならないよう、道を\n教えてやっているんだ。",
  "en": null,
  "slots": [
   "5F97A8"
  ]
 },
 {
  "id": "20E0AC",
  "jp": "そんなふうに言われる\nおぼえはない。",
  "en": null,
  "slots": [
   "5F97CC"
  ]
 },
 {
  "id": "20E098",
  "jp": "これをきくんだね。",
  "en": null,
  "slots": [
   "5F97F0"
  ]
 },
 {
  "id": "20E088",
  "jp": "わかっている…",
  "en": null,
  "slots": [
   "5F9838"
  ]
 },
 {
  "id": "20E05C",
  "jp": "君たちの集団は、何を目的と\nしているのか？",
  "en": null,
  "slots": [
   "5F985C"
  ]
 },
 {
  "id": "20E040",
  "jp": "人をおそうのが目的なのか…",
  "en": null,
  "slots": [
   "5F9880"
  ]
 },
 {
  "id": "20E02C",
  "jp": "人じゃねぇよッ！",
  "en": null,
  "slots": [
   "5F98A4"
  ]
 },
 {
  "id": "20DFF8",
  "jp": "俺たちはエディルレイドって\n武器を回収してんだ。",
  "en": null,
  "slots": [
   "5F98C8"
  ]
 },
 {
  "id": "20DFEC",
  "jp": "…そうさ…",
  "en": null,
  "slots": [
   "5F98EC"
  ]
 },
 {
  "id": "20DF9C",
  "jp": "エディルレイドなんてのは\n人の目にふれさせちゃいけない。\n危険なモノなんだよ。",
  "en": null,
  "slots": [
   "5F9910"
  ]
 },
 {
  "id": "20DF88",
  "jp": "モノですって！？",
  "en": null,
  "slots": [
   "5F9934"
  ]
 },
 {
  "id": "20DF80",
  "jp": "ダメ。",
  "en": null,
  "slots": [
   "5F9958"
  ]
 },
 {
  "id": "20DF68",
  "jp": "今はだまってなきゃ。",
  "en": null,
  "slots": [
   "5F997C"
  ]
 },
 {
  "id": "20DF24",
  "jp": "…それで、回収した\nエディルレイドたちは\nどこへ連れて行ったんだ？",
  "en": null,
  "slots": [
   "5F99C4"
  ]
 },
 {
  "id": "20DF1C",
  "jp": "はん。",
  "en": null,
  "slots": [
   "5F99E8"
  ]
 },
 {
  "id": "20DF00",
  "jp": "そんなこと、知らねーよ。",
  "en": null,
  "slots": [
   "5F9A0C"
  ]
 },
 {
  "id": "20DEE4",
  "jp": "じゃあこれを質問するね。",
  "en": null,
  "slots": [
   "5F9A30"
  ]
 },
 {
  "id": "20DED8",
  "jp": "いいぜ。",
  "en": null,
  "slots": [
   "5F9A78"
  ]
 },
 {
  "id": "20DE9C",
  "jp": "君たちの集団の中に\nエディルレイドプレジャーが\nいるね？",
  "en": null,
  "slots": [
   "5F9A9C"
  ]
 },
 {
  "id": "20DE60",
  "jp": "エディルレイドを回収したときに\n残ったプレジャーのことか？",
  "en": null,
  "slots": [
   "5F9AC0"
  ]
 },
 {
  "id": "20DE18",
  "jp": "アイツらは、俺たちの教えで\n自分達がまちがってたことに\n気づいたんだ。",
  "en": null,
  "slots": [
   "5F9AE4"
  ]
 },
 {
  "id": "20DDE0",
  "jp": "今じゃ、エディルレイド無しで\n一人で戦うようになった。",
  "en": null,
  "slots": [
   "5F9B08"
  ]
 },
 {
  "id": "20DDB8",
  "jp": "ちょっと待って。\nもう一度質問するけど",
  "en": null,
  "slots": [
   "5F9B2C"
  ]
 },
 {
  "id": "20DD7C",
  "jp": "君たちの集団に\nエディルレイドはいない\nってことなのか！？",
  "en": null,
  "slots": [
   "5F9B50"
  ]
 },
 {
  "id": "20DD6C",
  "jp": "当たり前だ。",
  "en": null,
  "slots": [
   "5F9B74"
  ]
 },
 {
  "id": "20DD1C",
  "jp": "エディルレイドをいらないと\n言ってるヤツらが、\nなぜ、エディルレイドを使う？",
  "en": null,
  "slots": [
   "5F9B98"
  ]
 },
 {
  "id": "20DD10",
  "jp": "そんな…",
  "en": null,
  "slots": [
   "5F9BBC"
  ]
 },
 {
  "id": "20DCFC",
  "jp": "人をあやつる謳や…",
  "en": null,
  "slots": [
   "5F9BE0"
  ]
 },
 {
  "id": "20DCB4",
  "jp": "少なくとも、リアクトをとく謳を\nうたえるエディルレイドが\nいるはずだ！",
  "en": null,
  "slots": [
   "5F9C04"
  ]
 },
 {
  "id": "20DC80",
  "jp": "リアクトをとくのは\nエディルレイドの謳じゃない。",
  "en": null,
  "slots": [
   "5F9C28"
  ]
 },
 {
  "id": "20DC34",
  "jp": "そういうチカラを持った\nまじないをかけるんだ。\nそれが謳に似てるだけさ。",
  "en": null,
  "slots": [
   "5F9C4C"
  ]
 },
 {
  "id": "20DC24",
  "jp": "まじない…？",
  "en": null,
  "slots": [
   "5F9C70"
  ]
 },
 {
  "id": "20DC10",
  "jp": "…わかりました…",
  "en": null,
  "slots": [
   "5F9C94"
  ]
 },
 {
  "id": "20DBE4",
  "jp": "何かあったら僕たちにも\n知らせて下さい。",
  "en": null,
  "slots": [
   "5F9CB8"
  ]
 },
 {
  "id": "20DBD0",
  "jp": "わかっています。",
  "en": null,
  "slots": [
   "5F9CDC"
  ]
 },
 {
  "id": "20DBB0",
  "jp": "一つだけ、伝えておきましょう。",
  "en": null,
  "slots": [
   "5F9D24"
  ]
 },
 {
  "id": "20DBA0",
  "jp": "何でしょうか。",
  "en": null,
  "slots": [
   "5F9D48"
  ]
 },
 {
  "id": "20DB84",
  "jp": "先ほどの男が答えたこと…",
  "en": null,
  "slots": [
   "5F9D6C"
  ]
 },
 {
  "id": "20DB48",
  "jp": "自分たちが\n『ブレイブスアルカ』であると\n言ってましたが、",
  "en": null,
  "slots": [
   "5F9D90"
  ]
 },
 {
  "id": "20DAFC",
  "jp": "ブレイブスアルカは、\n闘技場の地下にある施設を\n使っている団体のことです。",
  "en": null,
  "slots": [
   "5F9DB4"
  ]
 },
 {
  "id": "20DAE4",
  "jp": "どういうことですか！？",
  "en": null,
  "slots": [
   "5F9DD8"
  ]
 },
 {
  "id": "20DACC",
  "jp": "…信じたくはなかった…",
  "en": null,
  "slots": [
   "5F9DFC"
  ]
 },
 {
  "id": "20DA84",
  "jp": "私が知る彼らは\n『エディルレイドは人間と\n　共に生きられない』などと",
  "en": null,
  "slots": [
   "5F9E20"
  ]
 },
 {
  "id": "20DA64",
  "jp": "言うような人たちではなかった。",
  "en": null,
  "slots": [
   "5F9E44"
  ]
 },
 {
  "id": "20DA34",
  "jp": "もっと生き物すべてを\nやさしくつつむような…",
  "en": null,
  "slots": [
   "5F9E68"
  ]
 },
 {
  "id": "20DA20",
  "jp": "何でもありません。",
  "en": null,
  "slots": [
   "5F9EB0"
  ]
 },
 {
  "id": "20DA18",
  "jp": "では。",
  "en": null,
  "slots": [
   "5F9ED4"
  ]
 },
 {
  "id": "20DA10",
  "jp": "ふぅ…",
  "en": null,
  "slots": [
   "5F9F1C"
  ]
 },
 {
  "id": "20D9E8",
  "jp": "何とか、少しくらいは\nつかめたかな。",
  "en": null,
  "slots": [
   "5F9F40"
  ]
 },
 {
  "id": "20D9CC",
  "jp": "『ブレイブスアルカ』か。",
  "en": null,
  "slots": [
   "5F9F88"
  ]
 },
 {
  "id": "20D9A4",
  "jp": "今から闘技場の地下へ\n行ってみよう！",
  "en": null,
  "slots": [
   "5F9FAC"
  ]
 },
 {
  "id": "20D988",
  "jp": "う～ん、ムリなんじゃない？",
  "en": null,
  "slots": [
   "5F9FD0"
  ]
 },
 {
  "id": "20D94C",
  "jp": "シスカをこのまま\n連れて行くなんて\nムチャってもんでしょ。",
  "en": null,
  "slots": [
   "5F9FF4"
  ]
 },
 {
  "id": "20D940",
  "jp": "はひゅ～。",
  "en": null,
  "slots": [
   "5FA018"
  ]
 },
 {
  "id": "20D914",
  "jp": "そうとうキンチョーしちゃった\nみたいね。",
  "en": null,
  "slots": [
   "5FA03C"
  ]
 },
 {
  "id": "20D8EC",
  "jp": "プレッシャーには\n強いと思ってたけど。",
  "en": null,
  "slots": [
   "5FA060"
  ]
 },
 {
  "id": "20D8B8",
  "jp": "今日は宿へもどって、\n明日しらべることにしよう。",
  "en": null,
  "slots": [
   "5FA084"
  ]
 },
 {
  "id": "20D8A8",
  "jp": "リョーカイ！",
  "en": null,
  "slots": [
   "5FA0A8"
  ]
 },
 {
  "id": "20D898",
  "jp": "ふふゅう～。",
  "en": null,
  "slots": [
   "5FA0CC"
  ]
 },
