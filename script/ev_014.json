  "slots": [
   "5FAD98"
  ]
 },
 {
  "id": "212228",
  "jp": "レンさんも、いかがですか？",
  "en": null,
  "slots": [
   "5FADBC"
  ]
 },
 {
  "id": "212220",
  "jp": "え…",
  "en": null,
  "slots": [
   "5FADE0"
  ]
 },
 {
  "id": "212204",
  "jp": "きっと気持ちいいですよ！",
  "en": null,
  "slots": [
   "5FAE04"
  ]
 },
 {
  "id": "2121BC",
  "jp": "朝シャンって言いまして、\nさわやかな朝の風を\n感じさせてくれるのです。",
  "en": null,
  "slots": [
   "5FAE28"
  ]
 },
 {
  "id": "2121A4",
  "jp": "良くわからないけど…",
  "en": null,
  "slots": [
   "5FAE4C"
  ]
 },
 {
  "id": "212198",
  "jp": "わかった。",
  "en": null,
  "slots": [
   "5FAE70"
  ]
 },
 {
