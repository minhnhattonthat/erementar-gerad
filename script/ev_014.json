  "slots": [
   "5FAEB8"
  ]
 },
 {
  "id": "212148",
  "jp": "それじゃ、ちょっと待ってて～。",
  "en": null,
  "slots": [
   "5FAEDC"
  ]
 },
 {
  "id": "212140",
  "jp": "え！？",
