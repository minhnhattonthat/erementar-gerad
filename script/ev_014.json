  "jp": "別にかまわないけど…",
  "en": null,
  "slots": [
   "5FAD08"
  ]
 },
 {
  "id": "21228C",
  "jp": "僕たちは先に行ってようか。",
  "en": null,
  "slots": [
   "5FAD2C"
  ]
 },
 {
  "id": "212280",
  "jp": "あ、うん。",
  "en": null,
  "slots": [
   "5FAD50"
  ]
 },
 {
  "id": "21226C",
  "jp": "シャワーですか！",
