  "id": "220EB8",
  "jp": "事故のせいで、記憶が少し\nあいまいになってた\nだけじゃないですか。",
  "en": null,
  "slots": [
   "618618"
  ]
 },
 {
  "id": "220E6C",
  "jp": "そうですね。\n事故のために、まったく別の\n人に見えることもあるでしょう。",
  "en": null,
  "slots": [
   "61863C"
  ]
 },
 {
  "id": "220E60",
  "jp": "ですが！",
  "en": null,
  "slots": [
   "618660"
  ]
 },
