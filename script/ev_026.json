[
 {
  "id": "221638",
  "jp": "だが、そのままにしているのは\nよくないかもしれないね。\nそのうち、何とかするよ。",
  "en": "But perhaps leaving it as it is isn't good. I'll do something about it eventually.",
  "slots": [
   "617DF0"
  ]
 },
 {
  "id": "221614",
  "jp": "こわれてから、\n行ってないのか？",
  "en": "You haven't been back since it got wrecked?",
  "slots": [
   "617E14"
  ]
 },
 {
  "id": "22160C",
  "jp": "ああ。",
  "en": "No.",
  "slots": [
   "617E38"
  ]
 },
 {
  "id": "2215F4",
  "jp": "いい思い出はないから…",
  "en": "I have no good memories of it...",
  "slots": [
   "617E5C"
  ]
 },
 {
  "id": "2215E8",
  "jp": "そっか…",
  "en": "I see...",
  "slots": [
   "617E80"
  ]
 },
 {
  "id": "2215B8",
  "jp": "ほかに何かあるんだったら\n早くしてくれないか？",
  "en": "If there's anything else, could you make it quick?",
  "slots": [
   "617EA4"
  ]
 },
 {
  "id": "22159C",
  "jp": "エディルレイドなんだけど…",
  "en": "About Edel Raids...",
  "slots": [
   "617EC8"
  ]
 },
 {
  "id": "221588",
  "jp": "きらい…なのか？",
  "en": "Do you... hate them?",
  "slots": [
   "617EEC"
  ]
 },
 {
  "id": "221570",
  "jp": "きらってはいないよ。",
  "en": "I don't hate them.",
  "slots": [
   "617F34"
  ]
 },
 {
  "id": "221520",
  "jp": "ただ、人とリアクトすることで\n武器になる彼女たちが\nなぜこの世に生まれたのか。",
  "en": "It's just... Why were they born into this world, these girls who become weapons by Reacting with people?",
  "slots": [
   "617F58"
  ]
 },
 {
  "id": "2214E0",
  "jp": "彼女たちを武器としてしか\nあつかえない人間と\nエディルレイドが",
  "en": "For humans who can only treat them as weapons",
  "slots": [
   "617F7C"
  ]
 },
 {
  "id": "221498",
  "jp": "いっしょに生きてゆくのは\nむずかしいと私は考えている。\nそれだけだ。",
  "en": "and Edel Raids to live together is difficult, I believe. That's all.",
  "slots": [
   "617FA0"
  ]
 },
 {
  "id": "221458",
  "jp": "人とエディルレイドが愛し合う\nことなど…その先は見えている。",
  "en": "For a human and an Edel Raid to love each other... where that leads is plain to see.",
  "slots": [
   "617FE8"
  ]
 },
 {
  "id": "221414",
  "jp": "誰だってむすばれるなら\n人間の方がいいと、\n言うに決まっている…",
  "en": null,
  "slots": [
   "61800C"
  ]
 },
 {
  "id": "2213D4",
  "jp": "武器として愛せないなら\nいっしょになんか\nくらさない方がいい。",
  "en": null,
  "slots": [
   "618030"
  ]
 },
 {
  "id": "2213B4",
  "jp": "…人間じゃない…武器なのよ…",
  "en": null,
  "slots": [
   "618054"
  ]
 },
 {
  "id": "221384",
  "jp": "武器であることを忘れて\n生きろっていうの！？",
  "en": null,
  "slots": [
   "618078"
  ]
 },
 {
  "id": "22136C",
  "jp": "カールセン…さん…？",
  "en": null,
  "slots": [
   "61809C"
  ]
 },
 {
  "id": "221354",
  "jp": "出て行って…今すぐ！",
  "en": null,
  "slots": [
   "6180C0"
  ]
 },
 {
  "id": "221330",
  "jp": "おい、シスカッ！\nどうすんだよ。",
  "en": null,
  "slots": [
   "6180E4"
  ]
 },
 {
  "id": "221310",
  "jp": "どうするっていわれましても…",
  "en": null,
  "slots": [
   "618108"
  ]
 },
 {
  "id": "2212EC",
  "jp": "カールセンさん。\n最後にこれだけ…",
  "en": null,
  "slots": [
   "61812C"
  ]
 },
 {
  "id": "2212E0",
  "jp": "これを…",
  "en": null,
  "slots": [
   "618150"
  ]
 },
 {
  "id": "2212D0",
  "jp": "それが…何か。",
  "en": null,
  "slots": [
   "618174"
  ]
 },
 {
  "id": "2212C4",
  "jp": "何かって…",
  "en": null,
  "slots": [
   "618198"
  ]
 },
 {
  "id": "221284",
  "jp": "これは、カールセンさんの家の\nがれきの中から\n見つけたんです。",
  "en": null,
  "slots": [
   "6181BC"
  ]
 },
 {
  "id": "221270",
  "jp": "カールセンさん？",
  "en": null,
  "slots": [
   "618204"
  ]
 },
 {
  "id": "221248",
  "jp": "私の物を…とどけて\nくれたのですね。",
  "en": null,
  "slots": [
   "618228"
  ]
 },
 {
  "id": "221238",
  "jp": "ありがとう。",
  "en": null,
  "slots": [
   "61824C"
  ]
 },
 {
  "id": "221224",
  "jp": "カールセンさん。",
  "en": null,
  "slots": [
   "618294"
  ]
 },
 {
  "id": "221204",
  "jp": "これを、何だと思われました？",
  "en": null,
  "slots": [
   "6182B8"
  ]
 },
 {
  "id": "2211EC",
  "jp": "本…いや、日記かな。",
  "en": null,
  "slots": [
   "6182DC"
  ]
 },
 {
  "id": "22119C",
  "jp": "どちらにせよ、私の家から\n見つかったのだから\nもらいうけても問題ないだろう？",
  "en": null,
  "slots": [
   "618300"
  ]
 },
 {
  "id": "221174",
  "jp": "本か、日記かも…\nわからないんですか？",
  "en": null,
  "slots": [
   "618324"
  ]
 },
 {
  "id": "221158",
  "jp": "…わからなかったら何だね。",
  "en": null,
  "slots": [
   "618348"
  ]
 },
 {
  "id": "22113C",
  "jp": "早くこちらにわたしなさい。",
  "en": null,
  "slots": [
   "61836C"
  ]
 },
