  "slots": [
   "6183B4"
  ]
 },
 {
  "id": "2210B8",
  "jp": "私も見たところ、\nカールセンさんはこの本を\n知らなかった様子でした。",
  "en": null,
  "slots": [
   "6183D8"
  ]
 },
 {
  "id": "22106C",
  "jp": "しかるべき場所で、\n本当に持ちぬしがあなたなのか\nしらべたいと思います。",
  "en": null,
  "slots": [
   "6183FC"
  ]
 },
 {
  "id": "221044",
  "jp": "さ、あまりおそくなっても\nいけません。",
  "en": null,
  "slots": [
   "618420"
  ]
 },
