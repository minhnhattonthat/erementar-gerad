  "jp": "あんな、かなしい考えを持った\nカールセンさんに",
  "en": null,
  "slots": [
   "618684"
  ]
 },
 {
  "id": "220DF4",
  "jp": "この日記をわたして\nどうなります？\n見てもらえるんですか？",
  "en": null,
  "slots": [
   "6186A8"
  ]
 },
 {
  "id": "220DD8",
  "jp": "私は、そうは思えません。",
  "en": null,
  "slots": [
   "6186CC"
  ]
 },
