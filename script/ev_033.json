  "slots": [
   "62BC50"
  ]
 },
 {
  "id": "230874",
  "jp": "昔から、こういう『ここぞ』って\nときには、使われてきた\n言葉なんですよ。",
  "en": null,
  "slots": [
   "62BC74"
  ]
 },
 {
  "id": "23084C",
