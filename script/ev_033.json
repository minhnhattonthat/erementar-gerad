  "slots": [
   "62B6D4"
  ]
 },
 {
  "id": "230D00",
  "jp": "なげきの謳",
  "en": null,
  "slots": [
   "62B6F8"
  ]
 },
 {
  "id": "230CE4",
  "jp": "『目ざめの謳』のことだろ？",
