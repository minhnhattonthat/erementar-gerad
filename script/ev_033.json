  "slots": [
   "62B71C"
  ]
 },
 {
  "id": "230C8C",
  "jp": "それがうたえるエディルレイドを\n探してたから、エディルレイド\nプレジャーがねらわれた。",
  "en": null,
  "slots": [
   "62B740"
  ]
 },
 {
  "id": "230C80",
  "jp": "そうです。",
  "en": null,
  "slots": [
   "62B764"
  ]
 },
 {
  "id": "230C64",
  "jp": "『眠りの謳』のことだろ？",
  "en": null,
  "slots": [
   "62B788"
  ]
 },
 {
  "id": "230C48",
  "jp": "『なげきの謳』のことだろ？",
  "en": null,
  "slots": [
   "62B7AC"
  ]
 },
 {
  "id": "230C20",
  "jp": "俺が言うんだから、\nまちがいはないゼ。",
