   "601EA8"
  ]
 },
 {
  "id": "212658",
  "jp": "さぁ、近ごろ、私もあまり\n街へ行かないからね。",
  "en": null,
  "slots": [
   "601EF0"
  ]
 },
 {
  "id": "212618",
  "jp": "たまにこの教会へ来たときに\nはげましてやったり\nしてるんだが…",
  "en": null,
  "slots": [
   "601F14"
  ]
 },
 {
  "id": "2125E0",
  "jp": "そうですか。\nポルトガレオンに\nいらっしゃるんですね。",
  "en": null,
  "slots": [
   "601F38"
  ]
 },
 {
  "id": "212598",
  "jp": "またここにいらしたら、\n会いたいと言ってる者がいると\nお伝え下さい。",
  "en": null,
  "slots": [
   "601F5C"
  ]
 },
 {
  "id": "21257C",
  "jp": "わかった。伝えておこう。",
  "en": null,
  "slots": [
   "601F80"
  ]
 },
 {
  "id": "212528",
  "jp": "あの神父さんがいてくれれば、\n後は、森の危険を無くせば\n教会も昔みたいになるよな。",
  "en": null,
  "slots": [
   "601FEC"
  ]
 },
 {
  "id": "21251C",
  "jp": "シスカ？",
  "en": null,
  "slots": [
   "602034"
  ]
 },
 {
  "id": "2124D0",
  "jp": "神父さまがおっしゃっていた\nエディルレイドというのは\nエンダさんのことで、",
  "en": null,
  "slots": [
   "602058"
  ]
 },
 {
  "id": "212480",
  "jp": "青年は『カールセン』。\nこの教会は、ブレイブスアルカの\nものなんでしょうか…",
  "en": null,
  "slots": [
   "60207C"
  ]
 },
 {
  "id": "212470",
  "jp": "そうなのか？",
  "en": null,
  "slots": [
   "6020C4"
  ]
 },
 {
  "id": "21245C",
  "jp": "まだわかりませんが",
  "en": null,
  "slots": [
   "6020E8"
  ]
 },
 {
  "id": "212410",
  "jp": "『カールセン』という人が\n眠ったままだというのは\nまちがいなさそうですね。",
  "en": null,
  "slots": [
   "60210C"
  ]
 },
 {
  "id": "2123E4",
  "jp": "あ～、早くあの橋が\nおりてさえくれれば！",
  "en": null,
  "slots": [
   "602130"
  ]
 },
 {
  "id": "2123BC",
  "jp": "そんじゃ、とりあえず\n街へもどろうぜ。",
  "en": null,
  "slots": [
   "602154"
  ]
 },
 {
  "id": "212390",
  "jp": "宿屋にチルルがもどってるかも\nしんねーし。",
  "en": null,
  "slots": [
   "602178"
  ]
 },
 {
  "id": "212380",
  "jp": "そうですね。",
  "en": null,
  "slots": [
   "60219C"
  ]
 },
 {
  "id": "212348",
  "jp": "この場所もしずかですし、\n本当にステキな教会ですわ…",
  "en": null,
  "slots": [
   "602274"
  ]
 },
 {
  "id": "2144AC",
  "jp": "おっかえり～。",
  "en": null,
  "slots": [
   "602370"
  ]
 },
 {
  "id": "214488",
  "jp": "教会、どうだった？\nキレイだった？",
  "en": null,
  "slots": [
   "602394"
  ]
 },
 {
  "id": "214444",
  "jp": "俺はよくわかんねーけど\nシスカが、やけに\n気に入ってたみたいだぜ。",
  "en": null,
  "slots": [
   "6023B8"
  ]
 },
 {
  "id": "214424",
  "jp": "先輩も、女の人ってことですね。",
  "en": null,
  "slots": [
   "6023DC"
  ]
 },
 {
  "id": "214404",
  "jp": "…どういうイミですか、それ。",
  "en": null,
  "slots": [
   "602400"
  ]
 },
 {
  "id": "2143EC",
  "jp": "せ、せ、せ、先輩っ！",
  "en": null,
  "slots": [
   "602424"
  ]
 },
 {
  "id": "2143D8",
  "jp": "別に深いイミは…",
  "en": null,
  "slots": [
   "602448"
  ]
 },
 {
  "id": "2143C8",
  "jp": "まあいいです。",
  "en": null,
  "slots": [
   "60246C"
  ]
 },
 {
  "id": "214380",
  "jp": "ところで、チルルさんは？\nまだもどっていらっしゃらない\nんでしょうか？",
  "en": null,
  "slots": [
   "602490"
  ]
 },
 {
  "id": "21433C",
  "jp": "そろそろ昼だしさぁ、\nお昼ごはん食べてから\n行きましょうよぅ～。",
  "en": null,
  "slots": [
   "6024B4"
  ]
 },
 {
  "id": "21432C",
  "jp": "あーハイハイ。",
  "en": null,
  "slots": [
   "6024D8"
  ]
 },
 {
  "id": "21430C",
  "jp": "チルルさんがもどられたら、ね。",
  "en": null,
  "slots": [
   "6024FC"
  ]
 },
 {
  "id": "214300",
  "jp": "やたっ！",
  "en": null,
  "slots": [
   "602520"
  ]
 },
 {
  "id": "2142F4",
  "jp": "いったぁ…",
  "en": null,
  "slots": [
   "60258C"
  ]
 },
 {
  "id": "2142E4",
  "jp": "おりたのヨ！",
  "en": null,
  "slots": [
   "6025B0"
  ]
 },
 {
  "id": "2142CC",
  "jp": "橋がおりたのヨォ！！",
