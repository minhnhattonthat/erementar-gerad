  "en": null,
  "slots": [
   "6026AC"
  ]
 },
 {
  "id": "2141D0",
  "jp": "そんなの後、あとーッ！",
  "en": null,
  "slots": [
   "6026D0"
  ]
 },
 {
  "id": "2141C4",
  "jp": "まぁまぁ。",
  "en": null,
  "slots": [
   "6026F4"
  ]
 },
 {
  "id": "214184",
  "jp": "闘技場の前にもお店が出てますし\nお昼はそちらですませましょう。",
  "en": null,
  "slots": [
   "602718"
  ]
 },
 {
