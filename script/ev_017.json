  "slots": [
   "602784"
  ]
 },
 {
  "id": "214120",
  "jp": "それはまた夜に。",
  "en": null,
  "slots": [
   "6027A8"
  ]
 },
 {
  "id": "214114",
  "jp": "…ひどい…",
  "en": null,
  "slots": [
   "6027CC"
  ]
 },
 {
  "id": "2140E4",
  "jp": "それじゃ、闘技場の地下へ\nなぐりこみなのヨ！！",
  "en": null,
  "slots": [
   "6027F0"
  ]
 },
 {
  "id": "215CEC",
  "jp": "おばーちゃんのごはん\n食べたいぃ～！！",
  "en": null,
  "slots": [
   "60285C"
  ]
 },
 {
  "id": "215CD4",
