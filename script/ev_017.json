  "slots": [
   "60261C"
  ]
 },
 {
  "id": "21427C",
  "jp": "あら、ごめんなさいなのヨ。",
  "en": null,
  "slots": [
   "602640"
  ]
 },
 {
  "id": "21424C",
  "jp": "そんじゃ、お昼食べてから\n行きましょうね～。",
  "en": null,
  "slots": [
   "602664"
  ]
 },
 {
  "id": "214200",
  "jp": "そんな時間、ナイのヨ。\n今すぐに行かないと、\nまた橋があがっちゃうのヨ～。",
  "en": null,
  "slots": [
   "602688"
  ]
 },
 {
