  "slots": [
   "6025D4"
  ]
 },
 {
  "id": "2142B8",
  "jp": "わ、わかったから…",
  "en": null,
  "slots": [
   "6025F8"
  ]
 },
 {
  "id": "214298",
  "jp": "ちょっと、どいてチョウダイッ！",
