  "slots": [
   "5F2D10"
  ]
 },
 {
  "id": "2094AC",
  "jp": "闘技場に…？",
  "en": null,
  "slots": [
   "5F2D34"
  ]
 },
 {
  "id": "209484",
  "jp": "君はそうやって\nよく道に迷うんだね。",
  "en": null,
  "slots": [
   "5F2D58"
  ]
 },
 {
  "id": "209470",
  "jp": "え？　ええ、まぁ。",
  "en": null,
  "slots": [
   "5F2D7C"
  ]
 },
 {
  "id": "209430",
  "jp": "最近、闘技場には\nエディルレイドを連れた\n参加者が少なくない。",
  "en": null,
  "slots": [
   "5F2DA0"
  ]
 },
 {
  "id": "2093E0",
  "jp": "むかえうつファイターにまで\nエディルレイドプレジャーが\nランクしたくらいだ。",
  "en": null,
  "slots": [
   "5F2DC4"
  ]
 },
 {
  "id": "20939C",
  "jp": "君も、勝ちたいのなら\nエディルレイドを連れて\n参加するといいよ。",
  "en": null,
  "slots": [
   "5F2DE8"
  ]
 },
 {
  "id": "209380",
  "jp": "エディルレイド…ですか。",
  "en": null,
  "slots": [
   "5F2E0C"
  ]
 },
 {
  "id": "209354",
  "jp": "エディルレイドは\n武器として最強だからね。",
  "en": null,
  "slots": [
   "5F2E30"
  ]
 },
 {
  "id": "209334",
  "jp": "おや、だまりこんでしまって…",
  "en": null,
  "slots": [
   "5F2E78"
  ]
 },
 {
  "id": "20930C",
  "jp": "何か悪いことでも言って\nしまったかな？",
  "en": null,
  "slots": [
   "5F2E9C"
  ]
 },
 {
  "id": "209300",
  "jp": "いえいえ。",
  "en": null,
  "slots": [
   "5F2EC0"
  ]
 },
 {
  "id": "2092B8",
  "jp": "彼、ちょっと\nおなかがイターイとかで\nテンション下がりぎみなんです。",
  "en": null,
  "slots": [
   "5F2EE4"
  ]
 },
 {
  "id": "209284",
  "jp": "お気になさらないでください～。\nおジャマしました。",
  "en": null,
  "slots": [
   "5F2F08"
  ]
 },
 {
  "id": "209274",
  "jp": "ではこれで…",
  "en": null,
  "slots": [
   "5F2F2C"
  ]
 },
 {
  "id": "209254",
  "jp": "そうか。\n大事にするといい。",
  "en": null,
  "slots": [
   "5F2F50"
  ]
 },
 {
  "id": "20920C",
  "jp": "何なんですか、あの人。\n『エディルレイドは\n　最強の武器だー』なんて…",
  "en": null,
  "slots": [
   "5F2FBC"
  ]
 },
 {
  "id": "2091F0",
  "jp": "モノじゃないですっての！",
  "en": null,
  "slots": [
   "5F2FE0"
  ]
 },
 {
  "id": "2091C4",
  "jp": "でもクーさん、今回はよく\nたえましたね。",
  "en": null,
  "slots": [
   "5F3028"
  ]
 },
 {
  "id": "209198",
  "jp": "いつものクーさんなら\nどなり出しそうな…",
  "en": null,
  "slots": [
   "5F304C"
  ]
 },
 {
  "id": "209180",
  "jp": "うん、俺もそう思った。",
  "en": null,
  "slots": [
   "5F3070"
  ]
 },
 {
  "id": "209168",
  "jp": "だからダマってたんだ…",
  "en": null,
  "slots": [
   "5F3094"
  ]
 },
 {
  "id": "20912C",
  "jp": "あの人とケンカするつもりで\nあそこへ行ったんじゃないし。",
  "en": null,
  "slots": [
   "5F30B8"
  ]
 },
 {
  "id": "209120",
  "jp": "クーさん…",
  "en": null,
  "slots": [
   "5F30DC"
  ]
 },
 {
  "id": "2090D4",
  "jp": "それにしても、あの人は\nちょっとやそっとじゃ\n話をしてくれなさそうですね。",
  "en": null,
  "slots": [
   "5F3100"
  ]
 },
 {
  "id": "2090A4",
  "jp": "もう少し、話ができる\nきっかけを見つけないと。",
  "en": null,
  "slots": [
   "5F3124"
  ]
 },
 {
  "id": "209090",
  "jp": "出なおしましょう。",
  "en": null,
  "slots": [
   "5F3148"
  ]
 },
 {
  "id": "209074",
  "jp": "こんにちは…\nあのォー……",
  "en": null,
  "slots": [
   "5F3220"
  ]
 },
 {
  "id": "20904C",
  "jp": "いるみたいだけど、\n出てきてくんねー。",
  "en": null,
  "slots": [
   "5F3244"
  ]
 },
 {
  "id": "209020",
  "jp": "あっれ？\nばーちゃん何してんの？\nお店は？",
  "en": null,
  "slots": [
   "5F331C"
  ]
 },
 {
  "id": "209008",
  "jp": "お店？　何の話かね？",
  "en": null,
  "slots": [
   "5F3340"
  ]
 },
 {
  "id": "208FF0",
  "jp": "何って宿のことだよ。",
  "en": null,
  "slots": [
   "5F3364"
  ]
 },
 {
  "id": "208FC4",
  "jp": "晩メシ楽しみにしてなって\n言ってたじゃん。",
  "en": null,
  "slots": [
   "5F3388"
  ]
 },
 {
  "id": "208F78",
  "jp": "クーさんだめですよ。\nおかみさんだって仕事仕事で\nたいへんなんですから。",
  "en": null,
  "slots": [
   "5F33AC"
  ]
 },
 {
  "id": "208F70",
  "jp": "ね。",
  "en": null,
  "slots": [
   "5F33D0"
  ]
 },
 {
  "id": "208F3C",
  "jp": "宿って…そうかそうか。\n妹の店にとまってるんだね。",
  "en": null,
  "slots": [
   "5F33F4"
  ]
 },
 {
  "id": "208F18",
  "jp": "あの子のごはんは\nおいしいだろ？",
  "en": null,
  "slots": [
   "5F3418"
  ]
 },
 {
  "id": "208ED4",
  "jp": "あーっ！　わかった。\nおばーちゃんが話してた\nふたごのお姉さんだ！",
  "en": null,
  "slots": [
   "5F343C"
  ]
 },
 {
  "id": "208EC8",
  "jp": "ああーッ！",
  "en": null,
  "slots": [
   "5F3460"
  ]
 },
 {
  "id": "208E94",
  "jp": "『ポルトガレオンのちっさな\n　さくらんぼう』！！",
  "en": null,
  "slots": [
   "5F3484"
  ]
 },
 {
  "id": "208E6C",
  "jp": "フフフフフ。\nアタシたちそっくりだろ？",
  "en": null,
  "slots": [
   "5F34A8"
  ]
 },
 {
  "id": "208E40",
  "jp": "昔からよくまちがえられたり\nしたんだよ。",
  "en": null,
  "slots": [
   "5F34CC"
  ]
 },
 {
  "id": "208E20",
  "jp": "へぇ。\nほんとによく似てるな。",
  "en": null,
  "slots": [
   "5F34F0"
  ]
 },
 {
  "id": "208DEC",
  "jp": "で？　晩ごはんまでみんなで\nおさんぽしてるのかい？",
  "en": null,
  "slots": [
   "5F3514"
  ]
 },
 {
  "id": "208DDC",
  "jp": "うん、まあ…",
  "en": null,
  "slots": [
   "5F3538"
  ]
 },
 {
  "id": "208DAC",
  "jp": "そうだ、ばーちゃん。\n最近、かわったことない？",
  "en": null,
  "slots": [
   "5F355C"
  ]
 },
 {
  "id": "208D88",
  "jp": "たとえば\n人がいなくなった、とか。",
  "en": null,
  "slots": [
   "5F3580"
  ]
 },
 {
  "id": "208D78",
  "jp": "かわったこと？",
  "en": null,
  "slots": [
   "5F35A4"
  ]
 },
 {
  "id": "208D34",
  "jp": "人がいなくなるなんてのは\nたいへんなことだけど\nきいたことないね。",
  "en": null,
  "slots": [
   "5F35C8"
  ]
 },
 {
  "id": "208CF0",
  "jp": "そう言えば、最近。\nここから行ける道で\nさわぎがあったらしいね。",
  "en": null,
  "slots": [
   "5F3658"
  ]
 },
 {
  "id": "208CE4",
  "jp": "さわぎ？",
  "en": null,
  "slots": [
   "5F367C"
  ]
 },
 {
  "id": "208C88",
  "jp": "ウチのムスコが言うとったけど\n『広場からの道は危ないから\n　夜は外へ出たらダメだ』って。",
  "en": null,
  "slots": [
   "5F36A0"
  ]
 },
 {
  "id": "208C3C",
  "jp": "何があったか忘れてしまって\n思い出せないけど、そんなこと\nでよかったかね？",
  "en": null,
  "slots": [
   "5F36C4"
  ]
 },
 {
  "id": "208C08",
  "jp": "危ないって…おかみさん…\nじゃない、おばーちゃま。",
  "en": null,
  "slots": [
   "5F36E8"
  ]
 },
 {
  "id": "208BE0",
  "jp": "前はそうじゃなかったって\nことですか？",
  "en": null,
  "slots": [
   "5F370C"
  ]
 },
 {
  "id": "208BB0",
  "jp": "年よりが、夜出歩いても\n平気だったけどねぇ。",
  "en": null,
  "slots": [
   "5F3730"
  ]
 },
 {
  "id": "208B9C",
  "jp": "何でだったかねぇ…",
  "en": null,
  "slots": [
   "5F3754"
  ]
 },
 {
  "id": "208B64",
  "jp": "その、ムスコさんというのは\n今どちらにおられますか？",
  "en": null,
  "slots": [
   "5F3778"
  ]
 },
 {
  "id": "208B44",
  "jp": "お話をうかがいたいのですが。",
  "en": null,
  "slots": [
   "5F379C"
  ]
 },
 {
  "id": "208AF0",
  "jp": "あの子は昨日、船でほかの\n港へ行ってしまったから…\nたぶん十日はもどってこんよ。",
  "en": null,
  "slots": [
   "5F37C0"
  ]
 },
 {
  "id": "208AD8",
  "jp": "…タイミングの悪い…",
  "en": null,
  "slots": [
   "5F37E4"
  ]
 },
 {
  "id": "208AAC",
  "jp": "では、広場からどこへの道が\n危険だとかは？",
  "en": null,
  "slots": [
   "5F3808"
  ]
 },
 {
  "id": "208AA0",
  "jp": "…はて…",
  "en": null,
  "slots": [
   "5F382C"
  ]
 },
 {
  "id": "208A74",
  "jp": "まあ、そんだけきけりゃ\nいいんじゃないの？",
  "en": null,
  "slots": [
   "5F3850"
  ]
 },
 {
  "id": "208A58",
  "jp": "ありがとね、おばーちゃん。",
  "en": null,
  "slots": [
   "5F3874"
  ]
 },
 {
  "id": "208A30",
  "jp": "たいしたこと話せなくて\nすまないね。",
  "en": null,
  "slots": [
   "5F3898"
  ]
 },
 {
  "id": "208A1C",
  "jp": "さーて、どう思う？",
  "en": null,
  "slots": [
   "5F38E0"
  ]
 },
 {
  "id": "208A0C",
  "jp": "どう思うって…",
  "en": null,
  "slots": [
   "5F3904"
  ]
 },
 {
  "id": "2089CC",
  "jp": "ま、とりあえず\n『夜、広場からの道は危ない』\nってことだわね。",
  "en": null,
  "slots": [
   "5F3928"
  ]
 },
 {
  "id": "2089C4",
  "jp": "うん。",
  "en": null,
  "slots": [
   "5F394C",
   "5F3994",
   "5F5524",
   "5F6550"
  ]
 },
 {
  "id": "208974",
  "jp": "広場からの道は危険…か。\nここにいても何もなさそうだし\nどっかほか行こっか。",
  "en": null,
  "slots": [
   "5F3A90",
   "5F3AD8"
  ]
 },
 {
  "id": "208964",
  "jp": "お、いたいた。",
  "en": null,
  "slots": [
   "5F3BB0"
  ]
 },
 {
  "id": "208944",
  "jp": "じーさん、何かつってんのか？",
  "en": null,
  "slots": [
   "5F3BD4"
  ]
 },
 {
  "id": "208918",
  "jp": "クーさん！\nおじーさんにシツレイですよ！",
  "en": null,
  "slots": [
   "5F3BF8"
  ]
 },
 {
  "id": "2088F8",
  "jp": "ほほほ。\nかまわんかまわん。",
  "en": null,
  "slots": [
   "5F3C1C"
  ]
 },
 {
  "id": "2088E0",
  "jp": "また何か探しものかね？",
  "en": null,
  "slots": [
   "5F3C40"
  ]
 },
 {
  "id": "2088D4",
  "jp": "探し物？",
  "en": null,
  "slots": [
   "5F3C64"
  ]
 },
 {
  "id": "2088B4",
  "jp": "うーん、そうかもしれないな。",
  "en": null,
  "slots": [
   "5F3C88"
  ]
 },
 {
  "id": "208880",
  "jp": "じーさん、この街で最近\nかわったこととかなかった？",
  "en": null,
  "slots": [
   "5F3CAC"
  ]
 },
 {
  "id": "20884C",
  "jp": "ほら、なんかこう…\n人がもめてる声をきいた、とか。",
  "en": null,
  "slots": [
   "5F3CD0"
  ]
 },
 {
  "id": "20880C",
  "jp": "ケンカかね。\nそりゃお前さんたちが、こう\nピーチクパーチクと。",
  "en": null,
  "slots": [
   "5F3CF4"
  ]
 },
 {
  "id": "2087F4",
  "jp": "ぴ、ぴーちくぱーちく…",
  "en": null,
  "slots": [
   "5F3D18"
  ]
 },
 {
  "id": "2087E0",
  "jp": "ジョウダンじゃよ。",
  "en": null,
  "slots": [
   "5F3D3C"
  ]
 },
 {
  "id": "2087D0",
  "jp": "そうじゃのォ。",
  "en": null,
  "slots": [
   "5F3D60"
  ]
 },
 {
  "id": "208778",
  "jp": "たしか…夜、港からどっかに\n行く道は危ないからこまったな\nと、おいっこが言うとったな。",
  "en": null,
  "slots": [
   "5F3D84"
  ]
 },
 {
  "id": "208760",
  "jp": "危ないって、どうして？",
  "en": null,
  "slots": [
   "5F3DA8"
  ]
 },
 {
  "id": "208730",
  "jp": "さて、そこはおいっこに\nきいてみんことには。",
  "en": null,
  "slots": [
   "5F3DCC"
  ]
 }
]
