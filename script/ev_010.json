[
 {
  "id": "20687C",
  "jp": "夕食のときには見た人が\nいるんだから、やっぱまだ\n島の中にいるんじゃないのか？",
  "en": null,
  "slots": [
   "5EF248"
  ]
 },
 {
  "id": "20686C",
  "jp": "なるほどね。",
  "en": null,
  "slots": [
   "5EF26C"
  ]
 },
 {
  "id": "20682C",
  "jp": "あの橋がわたれないのなら、\nこの街からも\n出てないことになる。",
  "en": null,
  "slots": [
   "5EF290"
  ]
 },
 {
  "id": "2067FC",
  "jp": "きっと用事か何かで\n街から出ちまったんだよ。",
  "en": null,
  "slots": [
   "5EF2B4"
  ]
 },
 {
  "id": "2067EC",
  "jp": "俺はそう思う。",
  "en": null,
  "slots": [
   "5EF2D8"
  ]
 },
 {
  "id": "2067DC",
  "jp": "そうかしら。",
  "en": null,
  "slots": [
   "5EF320"
  ]
 },
 {
  "id": "2067C8",
  "jp": "何？　レンちゃん。",
  "en": null,
  "slots": [
   "5EF344"
  ]
 },
 {
  "id": "2067A0",
  "jp": "だって港でおじーさんが\n言ってたもの。",
  "en": null,
  "slots": [
   "5EF368"
  ]
 },
 {
  "id": "206774",
  "jp": "その人たち、夕食には\n誰かが見たんでしょ？",
  "en": null,
  "slots": [
   "5EF3B0"
  ]
 },
 {
  "id": "20672C",
  "jp": "たしかに、昨日の昼から\nさわぎが起こる今朝まで\nあの橋はわたれない。",
  "en": null,
  "slots": [
   "5EF3D4"
  ]
 },
 {
  "id": "2066FC",
  "jp": "つまり、この街からは\n出ていないことになるね。",
  "en": null,
  "slots": [
   "5EF3F8"
  ]
 },
 {
  "id": "2066D0",
  "jp": "まだ闘技場のある島に\n残っているのなら…",
  "en": null,
  "slots": [
   "5EF41C"
  ]
 },
 {
  "id": "2066A0",
  "jp": "行方不明でも何でもなく\n人の目が届かない場所で",
  "en": null,
  "slots": [
   "5EF440"
  ]
 },
 {
  "id": "206674",
  "jp": "ぐーぐー眠ってるだけ\nなんじゃないですか？",
  "en": null,
  "slots": [
   "5EF464"
  ]
 },
 {
  "id": "206658",
  "jp": "まったく、人さわがせな…",
  "en": null,
  "slots": [
   "5EF488"
  ]
 },
 {
  "id": "206610",
  "jp": "でもさ、せっかく街の\nシンボルだってのに\nそんなに橋がわたれないんじゃ",
  "en": null,
  "slots": [
   "5EF4AC"
  ]
 },
 {
  "id": "2065D0",
  "jp": "闘技場へ行きたいお客や\n参加者が、自由に\n行けないじゃない？",
  "en": null,
  "slots": [
   "5EF4D0"
  ]
 },
 {
  "id": "206590",
  "jp": "この街はあくまで港街だから\n船の多い日は\n一日中橋をあげたまま",
  "en": null,
  "slots": [
   "5EF4F4"
  ]
 },
 {
  "id": "206558",
  "jp": "だから島にとまるための施設や\n食べるところもあって、",
  "en": null,
  "slots": [
   "5EF518"
  ]
 },
 {
  "id": "206508",
  "jp": "参加者とお客さんは、闘技場の\nある島にとまりこんだり\nするようになってるんだ。",
  "en": null,
  "slots": [
   "5EF53C"
  ]
 },
 {
  "id": "206500",
  "jp": "へぇ。",
  "en": null,
  "slots": [
   "5EF560"
  ]
 },
 {
  "id": "2064B0",
  "jp": "でも、もしかしたら\nおじいさんが知らないところで\n橋はおりてたかもしれないし",
  "en": null,
  "slots": [
   "5EF584"
  ]
 },
 {
  "id": "20647C",
  "jp": "島から出ていない可能性がある\nってことにしとこう。",
  "en": null,
  "slots": [
   "5EF5A8"
  ]
 },
 {
  "id": "20645C",
  "jp": "エディルレイドのことだけど…",
  "en": null,
  "slots": [
   "5EF5CC"
  ]
 },
 {
  "id": "20640C",
  "jp": "街に入る前に言われた\n『エディルレイドだって\n　言わないほうがいい』ってさ、",
  "en": null,
  "slots": [
   "5EF5F0"
  ]
 },
 {
  "id": "2063DC",
  "jp": "黒集団におそわれるぞ、って\nことだったのかな？",
  "en": null,
  "slots": [
   "5EF614"
  ]
 },
 {
  "id": "2063BC",
  "jp": "うん。僕もそれは気になってた。",
  "en": null,
  "slots": [
   "5EF638"
  ]
 },
 {
  "id": "206360",
  "jp": "商人の少年に、ききなおしても\nのらりくらりかわされちゃって\n本当のイミはわからなかったね。",
  "en": null,
  "slots": [
   "5EF65C"
  ]
 },
 {
  "id": "206344",
  "jp": "もう一回きいてみようか…",
  "en": null,
  "slots": [
   "5EF680"
  ]
 },
 {
  "id": "206314",
  "jp": "はいよ、デザートの\nレモンのシャーベットだよ。",
  "en": null,
  "slots": [
   "5EF6A4"
  ]
 },
 {
  "id": "2062FC",
  "jp": "え？　誰かたのんだ？",
  "en": null,
  "slots": [
   "5EF6C8"
  ]
 },
 {
  "id": "2062D4",
  "jp": "ふふふ。\nサービスだから安心しとくれ。",
  "en": null,
  "slots": [
   "5EF6EC"
  ]
 },
 {
  "id": "2062BC",
  "jp": "わ～、あまずっぱ～い。",
  "en": null,
  "slots": [
   "5EF710"
  ]
 },
 {
  "id": "2062A4",
  "jp": "ところでおかみさん。",
  "en": null,
  "slots": [
   "5EF734"
  ]
 },
 {
  "id": "206268",
  "jp": "おかみさんは『エディルレイド』\nというのを知ってますか？",
  "en": null,
  "slots": [
   "5EF758"
  ]
 },
 {
  "id": "206250",
  "jp": "『えりるれいど』かい？",
  "en": null,
  "slots": [
   "5EF77C"
  ]
 },
 {
  "id": "206224",
  "jp": "いや、『エディルレイド』\nなんですけど…",
  "en": null,
  "slots": [
   "5EF7A0"
  ]
 },
 {
  "id": "2061E8",
  "jp": "すまないねぇ。\nうまく言えないけど、たぶん\n知ってるよ。",
  "en": null,
  "slots": [
   "5EF7C4"
  ]
 },
 {
  "id": "2061D8",
  "jp": "本当ですか！？",
  "en": null,
  "slots": [
   "5EF7E8"
  ]
 },
 {
  "id": "206190",
  "jp": "この街でのエディルレイドの\nウワサとか…きかせてもらって\nいいですか？",
  "en": null,
  "slots": [
   "5EF80C"
  ]
 },
 {
  "id": "206174",
  "jp": "ウワサって言われてもね…",
  "en": null,
  "slots": [
   "5EF830"
  ]
 },
 {
  "id": "206134",
  "jp": "アタシも昔から知ってる\nってだけだよ。\n何を話せばいいのかね。",
  "en": null,
  "slots": [
   "5EF854"
  ]
 },
 {
  "id": "20611C",
  "jp": "たとえば、そうですね…",
  "en": null,
  "slots": [
   "5EF878"
  ]
 },
 {
  "id": "2060E8",
  "jp": "よくきかれるのが\n『こわい』とか『危険だ』とか。",
  "en": null,
  "slots": [
   "5EF89C"
  ]
 },
 {
  "id": "2060CC",
  "jp": "そんなのありゃしないわよ。",
  "en": null,
  "slots": [
   "5EF8C0"
  ]
 },
 {
  "id": "206094",
  "jp": "エンダちゃんはとっても\nやさしくて、かわいらしくて。",
  "en": null,
  "slots": [
   "5EF8E4"
  ]
 },
 {
  "id": "206050",
  "jp": "かわいらしいと言えば\nアタシもわかいころは\n男の人にモテモテでね。",
  "en": null,
  "slots": [
   "5EF908"
  ]
 },
 {
  "id": "206004",
  "jp": "ふたごのお姉ちゃんと\n『ポルトガレオンのちっさな\n　さくらんぼう』とかって",
  "en": null,
  "slots": [
   "5EF92C"
  ]
 },
 {
  "id": "205FDC",
  "jp": "街の人気者だったんだよ。\nふふふふ。",
  "en": null,
  "slots": [
   "5EF950"
  ]
 },
 {
  "id": "205FCC",
  "jp": "ばーちゃん？",
  "en": null,
  "slots": [
   "5EF974"
  ]
 },
 {
  "id": "205FA0",
  "jp": "あら、やだやだ。\n何の話だったかしらね。",
  "en": null,
  "slots": [
   "5EF998"
  ]
 },
 {
  "id": "205F70",
  "jp": "エディルレイドが\n『こわい』とか『危険だ』とか",
  "en": null,
  "slots": [
   "5EF9BC"
  ]
 },
 {
  "id": "205F38",
  "jp": "そういうウワサを\nきいたことがないですか、\nという…",
  "en": null,
  "slots": [
   "5EF9E0"
  ]
 },
 {
  "id": "205F08",
  "jp": "そうそう、それだわね。\nエンダちゃんの話だね。",
  "en": null,
  "slots": [
   "5EFA04"
  ]
 },
 {
  "id": "205EB8",
  "jp": "そうね…危険だと言えば\nひっくりかえしたコップで\n手を切ったりしないか、とか…",
  "en": null,
  "slots": [
   "5EFA28"
  ]
 },
 {
  "id": "205E80",
  "jp": "その…『エンダちゃん』って\nエディルレイドなんですか？",
  "en": null,
  "slots": [
   "5EFA4C"
  ]
 },
 {
  "id": "205E54",
  "jp": "あら、エンダちゃんのことじゃ\nないのかね？",
  "en": null,
  "slots": [
   "5EFA70"
  ]
 },
 {
  "id": "205E0C",
  "jp": "そう言えば、あの子は自分が\nそのナントカだからって\n気にしてたわねぇ。",
  "en": null,
  "slots": [
   "5EFA94"
  ]
 },
 {
  "id": "205DFC",
  "jp": "おかみさん！",
  "en": null,
  "slots": [
   "5EFAB8"
  ]
 },
 {
  "id": "205DB0",
  "jp": "そ、そのエディ…じゃない\nエンダさんは、どこに\nいらっしゃるんですか！？",
  "en": null,
  "slots": [
   "5EFADC"
  ]
 },
 {
  "id": "205D70",
  "jp": "どこって、街をあちこち\n歩いてれば、どっかで\n会えると思うよ。",
  "en": null,
  "slots": [
   "5EFB00"
  ]
 },
 {
  "id": "205D54",
  "jp": "この街にいるということは…",
  "en": null,
  "slots": [
   "5EFB24"
  ]
 },
 {
  "id": "205D14",
  "jp": "おかみさん、そのエンダさんには\nプレジャーがいるんでしょうか？",
  "en": null,
  "slots": [
   "5EFB48"
  ]
 },
 {
  "id": "205CFC",
  "jp": "？　何だね…その……",
  "en": null,
  "slots": [
   "5EFB6C"
  ]
 },
 {
  "id": "205CE8",
  "jp": "だめです、先輩。",
  "en": null,
  "slots": [
   "5EFB90"
  ]
 },
 {
  "id": "205C9C",
  "jp": "おかみさんは\nエディルレイドや、彼女たちが\nリアクトするプレジャーのこと、",
  "en": null,
  "slots": [
   "5EFBB4"
  ]
 },
 {
  "id": "205C60",
  "jp": "そのあたりの話は\nまったく知らないのでは\nないでしょうか。",
  "en": null,
  "slots": [
   "5EFBD8"
  ]
 },
 {
  "id": "205C4C",
  "jp": "そのようですね。",
  "en": null,
  "slots": [
   "5EFBFC"
  ]
 },
 {
  "id": "205C04",
  "jp": "しかし、プレジャーのいない\nエディルレイドが\nこの街にいるというのに",
  "en": null,
  "slots": [
   "5EFC20"
  ]
 },
 {
  "id": "205BC8",
  "jp": "アークエイルが保護してない\nなんてことは、考えられません。",
  "en": null,
  "slots": [
   "5EFC44"
  ]
 },
 {
  "id": "205B80",
  "jp": "っていうかさぁ、\nおばーちゃんがこうやって\n知ってるエディルレイドが",
  "en": null,
  "slots": [
   "5EFC68"
  ]
 },
 {
  "id": "205B30",
  "jp": "この街の中で、何も問題なく\nくらしてるんだったら、\n危険なんか無いんじゃない？",
  "en": null,
  "slots": [
   "5EFC8C"
  ]
 },
 {
  "id": "205AFC",
  "jp": "でも、レンちゃんが\nねらわれたのは本当のことで…",
  "en": null,
  "slots": [
   "5EFCB0"
  ]
 },
 {
  "id": "205AC4",
  "jp": "エンダちゃんは、やさしくて\nかわいらしいんだってさ。",
  "en": null,
  "slots": [
   "5EFCD4"
  ]
 },
 {
  "id": "205AB8",
  "jp": "ううん…",
  "en": null,
  "slots": [
   "5EFCF8"
  ]
 },
 {
  "id": "205A88",
  "jp": "あらいけない。\nほかのお客さんが呼んでるわ。",
  "en": null,
  "slots": [
   "5EFD1C"
  ]
 },
 {
  "id": "205A78",
  "jp": "また後でね。",
  "en": null,
  "slots": [
   "5EFD40"
  ]
 },
 {
  "id": "205A68",
  "jp": "ばーちゃん！？",
  "en": null,
  "slots": [
   "5EFD88"
  ]
 },
 {
  "id": "205A58",
  "jp": "行っちゃった…",
  "en": null,
  "slots": [
   "5EFDD0"
  ]
 },
 {
  "id": "205A48",
  "jp": "しかたないよ。",
  "en": null,
  "slots": [
   "5EFDF4"
  ]
 },
 {
  "id": "205A00",
  "jp": "お昼は、ごはんを食べに来た\nお客さんの相手をしなきゃ\nいけないからね。",
  "en": null,
  "slots": [
   "5EFE18"
  ]
 },
 {
  "id": "2059C4",
  "jp": "また午後にでも話を\nきかせてもらえるように\nお願いしよう。",
  "en": null,
  "slots": [
   "5EFE3C"
  ]
 },
 {
  "id": "2059B4",
  "jp": "…そーだな…",
  "en": null,
  "slots": [
   "5EFE60"
  ]
 },
 {
  "id": "205990",
  "jp": "そのエンダって人。\n会えるかな？",
  "en": null,
  "slots": [
   "5EFE84"
  ]
 },
 {
  "id": "205970",
  "jp": "街を歩きまわってみましょう。",
  "en": null,
  "slots": [
   "5EFEA8"
  ]
 },
 {
  "id": "20B5C0",
  "jp": "そろそろ大丈夫かなぁ。",
  "en": null,
  "slots": [
   "5EFEF0"
  ]
 },
 {
  "id": "20B5AC",
  "jp": "どうしたんだい？",
  "en": null,
  "slots": [
   "5EFF14"
  ]
 },
 {
  "id": "20B568",
  "jp": "さっき、ばーちゃんに\nきけなかったこと\nもっかいきこうと思ってさ。",
  "en": null,
  "slots": [
   "5EFF38"
  ]
 },
 {
  "id": "20B53C",
  "jp": "この街にいるエディルレイド\nのことだね。",
  "en": null,
  "slots": [
   "5EFF5C"
  ]
 },
 {
  "id": "20B528",
  "jp": "エンダさん、か。",
  "en": null,
  "slots": [
   "5EFF80"
  ]
 },
 {
  "id": "20B500",
  "jp": "何か、もう少し話を\nきけるといいね。",
  "en": null,
  "slots": [
   "5EFFA4"
  ]
 },
 {
  "id": "20B4F8",
  "jp": "だな。",
  "en": null,
  "slots": [
   "5EFFC8"
  ]
 },
