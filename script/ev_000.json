   "5DB49C"
  ]
 },
 {
  "id": "1F54A4",
  "jp": "あああああああ…",
  "en": null,
  "slots": [
   "5D9E1C"
  ]
 },
 {
  "id": "1F5498",
  "jp": "キーア…",
  "en": null,
  "slots": [
   "5D9E64"
  ]
 },
 {
  "id": "1F546C",
  "jp": "でも、お金がないなんて…\nこまりましたね。",
  "en": null,
  "slots": [
   "5D9E88"
  ]
 },
 {
  "id": "1F5460",
  "jp": "…………",
  "en": null,
  "slots": [
   "5D9EAC",
   "5D9EF4"
  ]
 },
 {
  "id": "1F5454",
  "jp": "…先輩？",
  "en": null,
  "slots": [
   "5D9ED0"
  ]
 },
 {
  "id": "1F5448",
  "jp": "シスカ…？",
  "en": null,
  "slots": [
   "5D9F18"
  ]
 },
 {
  "id": "1F5434",
  "jp": "…ようじんぼう…",
  "en": null,
  "slots": [
   "5D9F3C"
  ]
 },
 {
  "id": "1F542C",
  "jp": "はぁ？",
  "en": null,
  "slots": [
   "5D9F60"
  ]
 },
 {
  "id": "1F53E0",
  "jp": "そうです、その手です！\nわれわれのセールスポイントと\n言えば、戦えること！",
  "en": null,
  "slots": [
   "5D9F84"
  ]
 },
 {
  "id": "1F5394",
  "jp": "悪におそわれている、\n通りすがりの人を助けたら\n何とそれは大金持ちだった！",
  "en": null,
  "slots": [
   "5D9FA8"
  ]
 },
 {
  "id": "1F5340",
  "jp": "われわれは大金持ちサンの\n『ヨウジンボウ』として\nお礼をがっぽりいただくのです。",
  "en": null,
  "slots": [
   "5D9FCC"
  ]
 },
 {
  "id": "1F5328",
  "jp": "悪って何よ、アクって。",
  "en": null,
  "slots": [
   "5D9FF0"
  ]
 },
 {
  "id": "1F52FC",
  "jp": "そうですよ、先輩。\nよく考えてみて下さい。",
  "en": null,
  "slots": [
   "5DA014"
  ]
 },
 {
  "id": "1F52A8",
  "jp": "たしかに、この森にはサンゾクや\n人にキバをむく危険な野生生物が\nたくさんいますけど",
  "en": null,
  "slots": [
   "5DA038"
  ]
 },
 {
  "id": "1F5278",
  "jp": "その分、この森が危険だと\nみんな知っています。",
  "en": null,
  "slots": [
   "5DA05C"
  ]
 },
 {
  "id": "1F5224",
  "jp": "わざわざおそわれるために\n何も準備しないで、通りすがる\n大金持ちなんていませんよ。",
  "en": null,
  "slots": [
   "5DA080"
  ]
 },
 {
  "id": "1F5218",
  "jp": "むむむ…",
  "en": null,
  "slots": [
   "5DA0A4"
  ]
 },
 {
  "id": "1F520C",
  "jp": "あれは…",
  "en": null,
  "slots": [
   "5DA0EC"
  ]
 },
 {
  "id": "1F51E0",
  "jp": "馬車が…こっちへ向かって\n走って来ますね…",
  "en": null,
  "slots": [
   "5DA110"
  ]
 },
 {
  "id": "1F51C0",
  "jp": "大変だ！\n馬車がおそわれてる！",
  "en": null,
  "slots": [
   "5DA134"
  ]
 },
 {
  "id": "1F51AC",
  "jp": "たッ、た、たすけ…",
  "en": null,
  "slots": [
   "5DA158"
  ]
 },
 {
  "id": "1F5188",
  "jp": "来ましたワ！\n私たちついてます！",
  "en": null,
  "slots": [
   "5DA17C"
  ]
 },
 {
  "id": "1F5140",
  "jp": "サンゾクにおそわれている\n馬車にのったお金持ち…\n私たちついてますよ！",
  "en": null,
  "slots": [
   "5DA1A0"
  ]
 },
 {
  "id": "1F5110",
  "jp": "ちょっと…シスカ？\n『オカネモチ』って何だ！？",
  "en": null,
  "slots": [
   "5DA1C4"
  ]
 },
 {
  "id": "1F5100",
  "jp": "いいですか？",
  "en": null,
  "slots": [
   "5DA1E8"
  ]
 },
 {
  "id": "1F50B0",
  "jp": "あわてないで、いつも通り\nレンさんとリアクトして\nサンゾクをやっつけるんです。",
  "en": null,
  "slots": [
   "5DA20C"
  ]
 },
 {
  "id": "1F5064",
  "jp": "このチャンスを逃がすわけには\nいかないんですから…\n気合を入れて下さいね？",
  "en": null,
  "slots": [
   "5DA230"
  ]
 },
 {
  "id": "1F5038",
  "jp": "逃がすわけには\nいかないって言われても…",
  "en": null,
  "slots": [
   "5DA254"
  ]
 },
 {
  "id": "1F5030",
  "jp": "クー。",
  "en": null,
  "slots": [
   "5DA278",
   "5DC0D8"
  ]
 },
 {
  "id": "1F4FE0",
  "jp": "ここは先輩の言う通り\nリアクトして切りぬけよう。\n僕もキーアと参戦するから。",
  "en": null,
  "slots": [
   "5DA29C"
  ]
 },
 {
  "id": "1F4FD8",
  "jp": "クー…",
  "en": null,
  "slots": [
   "5DA2C0",
   "5DACE0",
   "5DBC58"
  ]
 },
 {
  "id": "1F4FC4",
  "jp": "しよう、リアクト。",
  "en": null,
  "slots": [
   "5DA2E4"
  ]
 },
 {
  "id": "1F4F9C",
