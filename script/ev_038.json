[
 {
  "id": "237458",
  "jp": "この街でカードを使って\nお金をはらっていないことに\nなりました。",
  "en": null,
  "slots": [
   "635184"
  ]
 },
 {
  "id": "23744C",
  "jp": "…ハイ？",
  "en": null,
  "slots": [
   "6351A8"
  ]
 },
 {
  "id": "2373FC",
  "jp": "今回の事件を、本部に報告\nしないかわりに、この街には\nあなたたちは来ていない。",
  "en": null,
  "slots": [
   "6351CC"
  ]
 },
 {
  "id": "2373B0",
  "jp": "来ていない人たちが使ったお金を\nアークエイルがはらえる\nわけがありません。",
  "en": null,
  "slots": [
   "6351F0"
  ]
 },
 {
  "id": "23735C",
  "jp": "先ほど、その商人とも話を\nしましたが、商人の店から買った\nアイテムの代金をふくめ",
  "en": null,
  "slots": [
   "635214"
  ]
 },
 {
  "id": "237304",
  "jp": "宿代、食事代、そのほか\nこわした施設にかかった代金など\nそれらをまとめてはらうように。",
  "en": null,
  "slots": [
   "635238"
  ]
 },
 {
  "id": "2372D8",
  "jp": "それまでは、この街から\n出ないで下さい。",
  "en": null,
  "slots": [
   "63525C"
  ]
 },
 {
  "id": "2372D0",
  "jp": "では。",
  "en": null,
  "slots": [
   "635280"
  ]
 },
 {
  "id": "2372C4",
  "jp": "え？　え？",
  "en": null,
  "slots": [
   "6352C8"
  ]
 },
 {
  "id": "2372B0",
  "jp": "何の話…ですか？",
  "en": null,
  "slots": [
   "6352EC"
  ]
 },
 {
  "id": "237278",
  "jp": "僕たちは、借金をかえすまで\nこの街から出てはいけない。",
  "en": null,
  "slots": [
   "635310"
  ]
 },
 {
  "id": "237260",
  "jp": "そういうことですね。",
  "en": null,
  "slots": [
   "635334"
  ]
 },
 {
  "id": "237250",
  "jp": "なぜですッ！？",
  "en": null,
  "slots": [
   "635358"
  ]
 },
 {
  "id": "23720C",
  "jp": "商人さんから買った\nアイテム代だけじゃなく、\n宿代も、食事代も…",
  "en": null,
  "slots": [
   "63537C"
  ]
 },
 {
  "id": "2371D4",
  "jp": "こわれた施設にかかった\n代金ってどういうことですか！",
  "en": null,
  "slots": [
   "6353A0"
  ]
 },
 {
  "id": "237184",
  "jp": "おそらく、事件がなかったことに\nなったから、黒集団も\nいなかったことになって…",
  "en": null,
  "slots": [
   "6353C4"
  ]
 },
 {
  "id": "237158",
  "jp": "われわれにまわってきたんじゃ\nないかと…",
  "en": null,
  "slots": [
   "6353E8"
  ]
 },
 {
  "id": "237130",
  "jp": "街の中で、けっこう\n戦いましたからね。",
  "en": null,
  "slots": [
   "63540C"
  ]
 },
 {
  "id": "237124",
  "jp": "そんな…",
  "en": null,
  "slots": [
   "635430"
  ]
 },
 {
  "id": "237104",
  "jp": "がんばって\nかえしたってな～。",
  "en": null,
  "slots": [
   "635454"
  ]
 },
 {
  "id": "2370D4",
  "jp": "…何が…がんばって\nかえしたってな～ですか！！",
  "en": null,
  "slots": [
   "635478"
  ]
 },
 {
  "id": "237098",
  "jp": "事件がなかったことになれば\n私のサテイは、何もかわらない。",
  "en": null,
  "slots": [
   "63549C"
  ]
 },
 {
  "id": "23705C",
  "jp": "これだけの手がらをあげておいて\n１ガネーのボーナスも無い！",
  "en": null,
  "slots": [
   "6354C0"
  ]
 },
 {
  "id": "237038",
  "jp": "…このイカリのやり場を…\nどこに…",
  "en": null,
  "slots": [
   "6354E4"
  ]
 },
 {
  "id": "237018",
  "jp": "そ、そんじゃ、後はまかせたで。",
  "en": null,
  "slots": [
   "635508"
  ]
 },
 {
  "id": "237000",
