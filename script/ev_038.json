  "slots": [
   "635844"
  ]
 },
 {
  "id": "238B4C",
  "jp": "うまくうたえるか心配だけど\n時間があったら、たのむよ。",
  "en": null,
  "slots": [
   "635868"
  ]
 },
 {
  "id": "238BC4",
  "jp": "母ちゃんが元気になったから\nまたいっしょに店に\n出ることになってん。",
  "en": null,
  "slots": [
   "6358B0"
  ]
 },
 {
  "id": "238BA8",
  "jp": "へへ。\nやっぱうれしいわ。",
  "en": null,
  "slots": [
   "6358D4"
  ]
 },
 {
  "id": "238C50",
  "jp": "今回のことで、私も\nいろいろ考えさせられました。",
  "en": null,
  "slots": [
   "63591C"
  ]
 },
 {
  "id": "238C0C",
  "jp": "また、ちがったかたちで\nいっしょに仕事ができればと\n思っています。",
  "en": null,
  "slots": [
   "635940"
  ]
 },
 {
  "id": "238CD0",
  "jp": "これから、やらなければならない\nことが、たくさんあるけれど\n今は…とても幸せだ。",
  "en": null,
  "slots": [
   "635988"
  ]
 },
 {
