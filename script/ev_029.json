[
 {
  "id": "2269BC",
  "jp": "だとしたら誰が、何のために\nカールセンさんの名前を\nかたったんでしょう。",
  "en": null,
  "slots": [
   "61F728"
  ]
 },
 {
  "id": "2269A8",
  "jp": "何のためにって…",
  "en": null,
  "slots": [
   "61F74C"
  ]
 },
 {
  "id": "226970",
  "jp": "カールセンが起きたってことに\nしたかったんじゃないの？",
  "en": null,
  "slots": [
   "61F770"
  ]
 },
 {
  "id": "226964",
  "jp": "なぜです。",
  "en": null,
  "slots": [
   "61F794"
  ]
 },
 {
  "id": "226934",
  "jp": "ブレイブスアルカを\n自分の物にしたかったから。",
  "en": null,
  "slots": [
   "61F7B8"
  ]
 },
 {
  "id": "226918",
  "jp": "これ！　ゼッタイこれ！！",
  "en": null,
  "slots": [
   "61F7DC"
  ]
 },
 {
  "id": "2268E8",
  "jp": "ブレイブスアルカを\n手に入れるため…ですか。",
  "en": null,
  "slots": [
   "61F800"
  ]
 },
 {
  "id": "2268B8",
  "jp": "手に入れてどうする\nつもりだったんでしょう…",
  "en": null,
  "slots": [
   "61F824"
  ]
 },
 {
  "id": "226870",
  "jp": "エディルレイドと人間は\nいっしょにいたらダメだって\n言ってまわって…",
  "en": null,
  "slots": [
   "61F86C"
  ]
 },
 {
  "id": "226834",
  "jp": "ブレイブスアルカを\n手に入れる理由があまり\n無い…よね。",
  "en": null,
  "slots": [
   "61F8B4"
  ]
 },
 {
  "id": "226824",
  "jp": "そっかなぁ…",
  "en": null,
  "slots": [
   "61F8D8"
  ]
 },
 {
  "id": "2267FC",
  "jp": "いいセンいってたと\n思うんだけどな…",
  "en": null,
  "slots": [
   "61F8FC"
  ]
 },
 {
  "id": "2267D8",
  "jp": "ほかに何か可能性は\nありませんか？",
  "en": null,
  "slots": [
   "61F920"
  ]
 },
 {
  "id": "2267CC",
  "jp": "う～ん…",
  "en": null,
  "slots": [
   "61F944"
  ]
 },
 {
  "id": "2267A4",
  "jp": "まぼろしだったってのは\nどうかな！？",
  "en": null,
  "slots": [
   "61F968"
  ]
 },
 {
  "id": "226794",
  "jp": "まぼろしィ？",
  "en": null,
  "slots": [
   "61F98C"
  ]
 },
 {
  "id": "22675C",
  "jp": "全員でまぼろしのカールセンと\nしゃべってたって言うの？",
  "en": null,
  "slots": [
   "61F9B0"
  ]
 },
 {
  "id": "226708",
  "jp": "何かフシギな力で作られた\nまぼろしを使って、俺たちを\nワナにはめようとしたんだ！",
  "en": null,
  "slots": [
   "61F9F8"
  ]
 },
 {
  "id": "2266C8",
  "jp": "そうなると…それは、誰が\nしかけたワナに\nなるんでしょうか…",
  "en": null,
  "slots": [
   "61FA1C"
  ]
 },
 {
  "id": "2266C0",
  "jp": "え？",
  "en": null,
  "slots": [
   "61FA40"
  ]
 },
 {
  "id": "22667C",
  "jp": "僕たちに、カールセンさんが\n眠りからさめていると\n思わせておいて、",
  "en": null,
  "slots": [
   "61FA64"
  ]
 },
 {
  "id": "226650",
  "jp": "いったい何をするつもり\nなんでしょうかね。",
  "en": null,
  "slots": [
   "61FA88"
  ]
 },
 {
  "id": "226644",
  "jp": "うーん…",
  "en": null,
  "slots": [
   "61FAAC"
  ]
 },
 {
  "id": "226618",
  "jp": "もう少し、ほかの可能性も\n考えてみようか。",
  "en": null,
  "slots": [
   "61FAD0"
  ]
 },
 {
  "id": "226608",
  "jp": "それじゃあ…",
  "en": null,
  "slots": [
   "61FAF4"
  ]
 },
 {
  "id": "2265DC",
  "jp": "やっぱり、カールセン本人\nだったんだよ。",
  "en": null,
  "slots": [
   "61FB18"
  ]
 },
 {
  "id": "226598",
  "jp": "でも、エンダは\n『カールセンは眠ったまま』\nだって言ってたでしょ？",
  "en": null,
  "slots": [
   "61FB3C"
  ]
 },
 {
  "id": "226570",
  "jp": "それはエンダがウソを\nついたんだよ。",
  "en": null,
  "slots": [
   "61FB60"
  ]
 },
 {
  "id": "226564",
  "jp": "あの子が？",
  "en": null,
  "slots": [
   "61FB84"
  ]
 },
 {
  "id": "226558",
  "jp": "どうして？",
  "en": null,
  "slots": [
   "61FBA8"
  ]
 },
 {
  "id": "226514",
  "jp": "カールセンが起きたことを\n本当はナイショにして\nおきたかったんだ。",
  "en": null,
  "slots": [
   "61FBCC"
  ]
 },
 {
  "id": "2264E0",
  "jp": "でも、俺たちがエンダが\nいない間に会っちゃった。",
  "en": null,
  "slots": [
   "61FBF0"
  ]
 },
 {
  "id": "22649C",
  "jp": "みんなをおどろかすために\nまだ、かくしてたんだ…\nきっとそうだよ！",
  "en": null,
  "slots": [
   "61FC14"
  ]
 },
 {
  "id": "226470",
  "jp": "そのわりに、何だか\nかなしそうだったわね。",
  "en": null,
  "slots": [
   "61FC38"
  ]
 },
 {
  "id": "226468",
  "jp": "う…",
  "en": null,
  "slots": [
   "61FC5C"
  ]
 },
 {
  "id": "22643C",
  "jp": "だ、だったら\nみんなはどう思ったんだよ？",
  "en": null,
  "slots": [
   "61FC80"
  ]
 },
 {
  "id": "226414",
  "jp": "一つ、気になってることが\nあります。",
  "en": null,
  "slots": [
   "61FCA4"
  ]
 },
 {
  "id": "2263DC",
  "jp": "エディルレイドレーダーが\nこわれていないのだとしたら",
  "en": null,
  "slots": [
   "61FCEC"
  ]
 },
 {
  "id": "226394",
  "jp": "あのカールセンさんは\nエディルレイドだってことに\nなるんじゃないかと。",
  "en": null,
  "slots": [
   "61FD10"
  ]
 },
 {
  "id": "226388",
  "jp": "何で！？",
  "en": null,
  "slots": [
   "61FD34"
  ]
 },
 {
  "id": "226368",
  "jp": "男のエディルレイドですか！？",
  "en": null,
  "slots": [
   "61FD58"
  ]
 },
 {
  "id": "22634C",
  "jp": "まぁ、おちつきなさいって。",
  "en": null,
  "slots": [
   "61FDA0"
  ]
 },
 {
  "id": "2262F4",
  "jp": "男のエディルレイドではなく\n男に化けられるエディルレイド\nとかなら、ありえるでしょ。",
  "en": null,
  "slots": [
   "61FDC4"
  ]
 },
 {
  "id": "2262E0",
  "jp": "姿を…かえる…？",
  "en": null,
  "slots": [
   "61FDE8"
  ]
 },
 {
  "id": "2262C8",
  "jp": "あくまで可能性です。",
  "en": null,
  "slots": [
   "61FE0C"
  ]
 },
 {
  "id": "226284",
  "jp": "エディルレイドがレーダーに\nうつらないようにできるのは\n可能です。",
  "en": null,
  "slots": [
   "61FE30"
  ]
 },
 {
  "id": "226264",
  "jp": "そうですよね？　チルルさん。",
  "en": null,
  "slots": [
   "61FE54"
  ]
 },
 {
  "id": "226254",
  "jp": "そうなのヨ。",
  "en": null,
  "slots": [
   "61FE78"
  ]
 },
 {
  "id": "226220",
  "jp": "あたしはアークエイルの\nレーダーにはうつらないわ。",
  "en": null,
  "slots": [
   "61FE9C"
  ]
 },
 {
  "id": "2261F8",
  "jp": "しかし、\nエディルレイドでもないのに、",
  "en": null,
  "slots": [
   "61FEC0"
  ]
 },
 {
  "id": "2261C4",
  "jp": "レーダーにうつることは\nできないんじゃないかと。",
  "en": null,
  "slots": [
   "61FEE4"
  ]
 },
 {
  "id": "226188",
  "jp": "だから、あのカールセンが\nエディルレイドじゃないかって…",
  "en": null,
  "slots": [
   "61FF08"
  ]
 },
 {
  "id": "226164",
  "jp": "そんなことナイって！\nないない。",
  "en": null,
  "slots": [
   "61FF2C"
  ]
 },
 {
  "id": "226118",
  "jp": "では、なぜレーダーが\nエディルレイドをうつしたか\n説明して下さるんですか？",
  "en": null,
  "slots": [
   "61FF50"
  ]
 },
 {
  "id": "226110",
  "jp": "え…",
  "en": null,
  "slots": [
   "61FF74"
  ]
 },
 {
  "id": "2260F0",
  "jp": "ほらほら。\n説明して下さいよ。",
  "en": null,
  "slots": [
   "61FFBC"
  ]
 },
 {
  "id": "2260DC",
  "jp": "セ・ツ・メ・イ！",
  "en": null,
  "slots": [
   "61FFE0"
  ]
 },
 {
  "id": "2260C8",
  "jp": "何だよ、モー！！",
  "en": null,
  "slots": [
   "620004"
  ]
 },
 {
  "id": "2260B0",
  "jp": "長く…なりそうだね…",
  "en": null,
  "slots": [
   "62004C"
  ]
 },
 {
  "id": "226098",
  "jp": "…終わるまで、寝てる…",
  "en": null,
  "slots": [
   "620070"
  ]
 },
 {
  "id": "226070",
  "jp": "レーダーがぶっこわれて\nたんだろ！？",
  "en": null,
  "slots": [
   "620094"
  ]
 },
 {
  "id": "22605C",
  "jp": "こわれてません！",
  "en": null,
  "slots": [
   "6200B8"
  ]
 },
 {
  "id": "226024",
  "jp": "こわれてるのは、クーさんの\nアタマじゃないですか！？",
  "en": null,
  "slots": [
   "6200DC"
  ]
 },
