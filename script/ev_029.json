 {
  "id": "2297A8",
  "jp": "あれは、お前がのぞむ謳を\nうたえるエディルレイドだ。",
  "en": null,
  "slots": [
   "6201D8"
  ]
 },
 {
  "id": "22975C",
  "jp": "あのレンというエディルレイドは\nまちがいなく『七煌宝樹』の\nメザーランス…",
  "en": null,
  "slots": [
   "6201FC"
  ]
 },
 {
  "id": "22974C",
  "jp": "七煌…宝樹…",
  "en": null,
  "slots": [
   "620220"
  ]
 },
 {
