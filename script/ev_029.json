  "jp": "あのエディルレイドさえ\n手に入れれば…",
  "en": null,
  "slots": [
   "620244"
  ]
 },
 {
  "id": "2296FC",
  "jp": "お前がのぞむものも\n手に入るだろう。",
  "en": null,
  "slots": [
   "620268"
  ]
 },
 {
  "id": "2296E8",
  "jp": "私が…のぞむもの？",
  "en": null,
  "slots": [
   "62028C"
  ]
 },
 {
  "id": "2296D8",
  "jp": "ああ。そうだ。",
  "en": null,
  "slots": [
   "6202B0"
  ]
 },
 {
  "id": "2296BC",
  "jp": "ヤツを助けたいんだろう？",
  "en": null,
  "slots": [
   "6202D4"
  ]
 },
 {
  "id": "2296B0",
  "jp": "エンダ…？",
  "en": null,
  "slots": [
   "6202F8"
  ]
 },
 {
  "id": "2296A0",
  "jp": "助け…た…い…",
  "en": null,
  "slots": [
   "620340"
  ]
 },
 {
  "id": "22965C",
  "jp": "だいたい、クーさんは\n私に話をするときと\nレンさんに話をするときと",
  "en": null,
  "slots": [
   "6203AC"
  ]
 },
 {
  "id": "229624",
  "jp": "ぜっんぜん心づかいが\nちがいます！\nちがいすぎです！！",
  "en": null,
  "slots": [
   "6203D0"
  ]
 },
 {
  "id": "2295E8",
  "jp": "レンをシスカといっしょにしたら\nレンがかわいそうだろ！？",
  "en": null,
  "slots": [
   "6203F4"
  ]
 },
 {
  "id": "2295DC",
  "jp": "んまぁっ！",
  "en": null,
  "slots": [
   "620418"
  ]
 },
 {
  "id": "2295C4",
  "jp": "言って下さいますね…",
  "en": null,
  "slots": [
   "62043C"
  ]
 },
 {
  "id": "2295A8",
  "jp": "も～、いいかげんにしなよ。",
  "en": null,
  "slots": [
   "620460"
  ]
 },
 {
  "id": "22958C",
  "jp": "夜になっちゃったじゃない。",
  "en": null,
  "slots": [
   "620484"
  ]
 },
 {
  "id": "22955C",
  "jp": "こんなに、クーさんに\n言いたいだけ言われたら、",
  "en": null,
  "slots": [
   "6204A8"
  ]
 },
 {
  "id": "22952C",
  "jp": "こちらも何か言わないと\n気がすみませんわッ！！",
  "en": null,
  "slots": [
   "6204CC"
  ]
 },
 {
  "id": "2294E8",
  "jp": "俺だって、いつもいつも\nバカにされてて\n今、何か言ってやんないと…",
  "en": null,
  "slots": [
   "6204F0"
  ]
 },
 {
  "id": "2294D0",
  "jp": "はいはい。そこまで。",
  "en": null,
  "slots": [
   "620514"
  ]
 },
 {
  "id": "2294BC",
  "jp": "お客さんですよ。",
  "en": null,
  "slots": [
   "620538"
  ]
 },
 {
  "id": "2294B0",
  "jp": "お客さま？",
  "en": null,
  "slots": [
   "62055C"
  ]
 },
 {
  "id": "22949C",
  "jp": "何をあそんでいる。",
  "en": null,
  "slots": [
   "620580"
  ]
 },
 {
  "id": "22945C",
  "jp": "お前たちが探している\nエディルレイドが\nどうなってもいいのか？",
  "en": null,
  "slots": [
   "6205A4"
  ]
 },
 {
  "id": "229450",
  "jp": "ヴォル君！",
  "en": null,
  "slots": [
   "6205C8"
  ]
 },
 {
  "id": "229440",
  "jp": "ヴォルクス！？",
  "en": null,
  "slots": [
   "6205EC"
  ]
 },
 {
  "id": "229400",
  "jp": "エディルレイドが\nどうなってもいいって…\nどういうことですか？",
  "en": null,
  "slots": [
   "620610"
  ]
 },
 {
  "id": "2293D4",
  "jp": "この街で商売をしている\nガキを知ってるか。",
  "en": null,
  "slots": [
   "620634"
  ]
 },
 {
  "id": "2293A8",
  "jp": "あたし、知ってる！\n商人さんのことでしょ？",
  "en": null,
  "slots": [
   "620658"
  ]
 },
 {
  "id": "22938C",
  "jp": "どこにいるか、わかるわヨ。",
