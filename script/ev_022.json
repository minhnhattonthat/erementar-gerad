[
 {
  "id": "21C284",
  "jp": "で、ヴォルクスはどこに？",
  "en": null,
  "slots": [
   "60DE78"
  ]
 },
 {
  "id": "21C250",
  "jp": "あっちヨ、カールセンが\nいばっていつもいるトコロ！",
  "en": null,
  "slots": [
   "60DE9C"
  ]
 },
 {
  "id": "21C240",
  "jp": "行ってみよう！",
  "en": null,
  "slots": [
   "60DEC0"
  ]
 },
 {
  "id": "21C22C",
  "jp": "アークエイルです！",
  "en": null,
  "slots": [
   "60DF2C"
  ]
 },
 {
  "id": "21C1F8",
  "jp": "ムダなていこうはやめて\nわれわれにしたがいなさい！",
  "en": null,
  "slots": [
   "60DF50"
  ]
 },
 {
  "id": "21C1F0",
  "jp": "あれ？",
  "en": null,
  "slots": [
   "60DF74"
  ]
 },
 {
  "id": "21C1BC",
  "jp": "誰もいないとは言え、\nもう少し考えて動くんだな。",
  "en": null,
  "slots": [
   "60DF98"
  ]
 },
 {
  "id": "21C1A4",
  "jp": "後ろを…とられました…",
  "en": null,
  "slots": [
   "60DFBC"
  ]
 },
 {
  "id": "21C198",
  "jp": "先輩ッ！",
  "en": null,
  "slots": [
   "60DFE0"
  ]
 },
 {
  "id": "21C170",
  "jp": "おっと。\nお前らとやり合う気はない。",
  "en": null,
  "slots": [
   "60E004"
  ]
 },
 {
  "id": "21C130",
  "jp": "俺を好きに使ってくれた\nヤツらに、ひとあわふかせて\nやりたい。",
  "en": null,
  "slots": [
   "60E028"
  ]
 },
 {
  "id": "21C11C",
  "jp": "お前らも同じだろ？",
  "en": null,
  "slots": [
   "60E04C"
  ]
 },
 {
  "id": "21C0F4",
  "jp": "エディルレイドハンター\nヴォルクス！？",
  "en": null,
  "slots": [
   "60E070"
  ]
 },
 {
  "id": "21C0AC",
  "jp": "好きに使って…ってことは\nやはりあなたはあやつられて\nいたんですか？",
  "en": null,
  "slots": [
   "60E094"
  ]
 },
 {
  "id": "21C094",
  "jp": "とりあえず外へ出ろ。",
  "en": null,
  "slots": [
   "60E0DC"
  ]
 },
 {
  "id": "21C064",
  "jp": "ここじゃヤツらが\nもどったときにやっかいだ。",
  "en": null,
  "slots": [
   "60E100"
  ]
 },
 {
  "id": "21C050",
  "jp": "…なさけない話だ。",
  "en": null,
  "slots": [
   "60E16C"
  ]
 },
 {
  "id": "21C01C",
  "jp": "同じ様にあやつられてる\nヤツらを見てぞっとした。",
  "en": null,
  "slots": [
   "60E190"
  ]
 },
 {
  "id": "21BFEC",
  "jp": "こうやって元にもどったのは\n俺だけのようだが。",
  "en": null,
  "slots": [
   "60E1B4"
  ]
 },
 {
  "id": "21BFA0",
  "jp": "他のヤツらは、今も街へ出て\n言われるままにプレジャーを\nおそってるだろう。",
  "en": null,
  "slots": [
   "60E1D8"
  ]
 },
 {
  "id": "21BF58",
  "jp": "あんたが気がついたのって、\nそれってこの子のおかげ\nかもしれないわね。",
  "en": null,
  "slots": [
   "60E1FC"
  ]
 },
 {
  "id": "21BF50",
  "jp": "エ…",
  "en": null,
  "slots": [
   "60E220"
  ]
 },
 {
  "id": "21BF08",
  "jp": "この子がひっしにあんたの\n名前を呼んだから、\n目がさめたのかもってね。",
  "en": null,
  "slots": [
   "60E244"
  ]
 },
 {
  "id": "21BF00",
  "jp": "ふん。",
  "en": null,
  "slots": [
   "60E268"
  ]
 },
 {
  "id": "21BEF4",
  "jp": "ヴォル君…",
  "en": null,
  "slots": [
   "60E28C"
  ]
 },
 {
  "id": "21BEC8",
  "jp": "お前はこいつらといっしょに\n行動していろ。",
  "en": null,
  "slots": [
   "60E2B0"
  ]
 },
 {
  "id": "21BE8C",
  "jp": "俺はしばらく\nあやつられたフリをして\nヤツらをしらべる。",
  "en": null,
  "slots": [
   "60E2D4"
  ]
 },
 {
  "id": "21BE80",
  "jp": "いいな。",
  "en": null,
  "slots": [
   "60E2F8"
  ]
 },
 {
  "id": "21BE6C",
  "jp": "わ、わかったのヨ。",
  "en": null,
  "slots": [
   "60E31C"
  ]
 },
 {
  "id": "21BE30",
  "jp": "でもでも、何かあったときは\nヴォル君のトコへ行くからネ！",
  "en": null,
  "slots": [
   "60E340"
  ]
 },
 {
  "id": "21BE18",
  "jp": "…ジャマだけはするな。",
  "en": null,
  "slots": [
   "60E364"
  ]
 },
 {
  "id": "21BE08",
  "jp": "ハンターさん。",
  "en": null,
  "slots": [
   "60E3AC"
  ]
 },
 {
  "id": "21BDD0",
  "jp": "少しききたいことが\nあるんですけど\nよろしいですか？",
  "en": null,
  "slots": [
   "60E3D0"
  ]
 },
 {
  "id": "21BD8C",
  "jp": "あまりこちらから話すばかり\nではワリが合わないが…\nいいだろう。",
  "en": null,
  "slots": [
   "60E3F4"
  ]
 },
 {
  "id": "21BD38",
  "jp": "私たちアークエイルは\nエディルレイドがどこにいるか\nわかるレーダーを持っています。",
  "en": null,
  "slots": [
   "60E418"
  ]
 },
 {
  "id": "21BD08",
  "jp": "ところが今、これにチルルさんは\nうつりません。",
  "en": null,
  "slots": [
   "60E43C"
  ]
 },
 {
  "id": "21BCB8",
  "jp": "午後に一度、使ったときには\nブレイブスアルカの中に\nレンさんとキーアのほかに",
  "en": null,
  "slots": [
   "60E460"
  ]
 },
 {
  "id": "21BC80",
  "jp": "たしかにエディルレイドが\n一人いるとうつっていたのに…",
  "en": null,
  "slots": [
   "60E484"
  ]
 },
 {
  "id": "21BC24",
  "jp": "いいえ、チルルさんだけじゃ\nないです。つかまっていたはずの\nほかのエディルレイドたちも。",
  "en": null,
  "slots": [
   "60E4A8"
  ]
 },
 {
  "id": "21BBD4",
  "jp": "そんなのカンタンじゃない？\nアタシはヴォル君お手せい\n『愛のハートつきオビ』で",
  "en": null,
  "slots": [
   "60E4CC"
  ]
 },
 {
  "id": "21BB84",
  "jp": "レーダーにうつらないし、\nほかの子たちはどっかに\n連れ出されちゃった後だもの。",
  "en": null,
  "slots": [
   "60E4F0"
  ]
 },
 {
  "id": "21BB48",
  "jp": "…あるいは、エレメンタル\nジェレイドを封印されているか。",
  "en": null,
  "slots": [
   "60E514"
  ]
 },
 {
  "id": "21BB2C",
  "jp": "だが、あそこは誰もいない。",
  "en": null,
  "slots": [
   "60E538"
  ]
 },
 {
  "id": "21BAF8",
  "jp": "俺が気づいたときぐらいに\nどこかへ連れて行かれた。",
  "en": null,
  "slots": [
   "60E55C"
  ]
 },
 {
  "id": "21BAE8",
  "jp": "何ですって！？",
  "en": null,
  "slots": [
   "60E580"
  ]
 },
 {
  "id": "21BAB8",
  "jp": "じゃあ、それをみすみす\n見逃したんですかっ！？",
  "en": null,
  "slots": [
   "60E5A4"
  ]
 },
 {
  "id": "21BA9C",
  "jp": "それはお前らの仕事だろ？",
  "en": null,
  "slots": [
   "60E5C8"
  ]
 },
 {
  "id": "21BA6C",
  "jp": "まあいい。おもしろい話を\nきかせてもらった。",
  "en": null,
  "slots": [
   "60E5EC"
  ]
 },
 {
  "id": "21BA28",
  "jp": "お前らは外からカールセンに\nついてしらべろ。\nそれがてっとり早い。",
  "en": null,
  "slots": [
   "60E610"
  ]
 },
 {
  "id": "21BA04",
  "jp": "ちょっと、\n『おもしろい』って…",
  "en": null,
  "slots": [
   "60E634"
  ]
 },
 {
  "id": "21B9E4",
  "jp": "チルルはレーダーにうつらない。",
  "en": null,
  "slots": [
   "60E658"
  ]
 },
 {
  "id": "21B9B4",
  "jp": "ほかのエディルレイドは\n連れ出された後だった。",
  "en": null,
  "slots": [
   "60E67C"
  ]
 },
 {
  "id": "21B990",
  "jp": "今はそれだけわかれば\nいいだろう。",
  "en": null,
  "slots": [
   "60E6A0"
  ]
 },
 {
  "id": "21B964",
  "jp": "行け。\nそろそろヤツらが\nもどって来る。",
  "en": null,
  "slots": [
   "60E6C4"
  ]
 },
 {
  "id": "21B950",
  "jp": "あのっちょっと！！",
  "en": null,
  "slots": [
   "60E70C"
  ]
 },
 {
  "id": "21B938",
  "jp": "行っちゃいましたね。",
  "en": null,
  "slots": [
   "60E730"
  ]
 },
 {
  "id": "21B904",
  "jp": "何なんですか、自分だけ\nわかったようなこと言って…",
  "en": null,
  "slots": [
   "60E754"
  ]
 },
 {
  "id": "21B8D4",
  "jp": "とにかく僕たちも早くここから\nはなれましょう。",
  "en": null,
  "slots": [
   "60E778"
  ]
 },
 {
  "id": "21B8C0",
  "jp": "君もいっしょにね。",
  "en": null,
  "slots": [
   "60E79C"
  ]
 },
 {
  "id": "21B8B0",
  "jp": "わかったのヨ。",
  "en": null,
  "slots": [
   "60E7C0"
  ]
 },
 {
  "id": "21C73C",
  "jp": "いったい私は…\nどうすればいいと言うの…？",
  "en": null,
  "slots": [
   "60E874"
  ]
 },
 {
  "id": "21C720",
  "jp": "あの人の…声がききたい…",
  "en": null,
  "slots": [
   "60E8BC"
  ]
 },
 {
  "id": "21D338",
  "jp": "モグモグモグ…",
  "en": null,
  "slots": [
   "60E928"
  ]
 },
 {
  "id": "21D330",
  "jp": "………",
  "en": null,
  "slots": [
