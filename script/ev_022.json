  ]
 },
 {
  "id": "21D078",
  "jp": "昨日、とらえた黒集団の何人かは\n闘技場のバトルにエントリーした\nことがありました。",
  "en": null,
  "slots": [
   "60EC88"
  ]
 },
 {
  "id": "21D048",
  "jp": "彼らは、みな\nエディルレイドプレジャーです。",
  "en": null,
  "slots": [
   "60ECAC"
  ]
