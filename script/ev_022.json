 {
  "id": "21D318",
  "jp": "モシャモシャモシャ…",
  "en": null,
  "slots": [
   "60E970"
  ]
 },
 {
  "id": "21D2EC",
  "jp": "どうしました、先輩。\n食べないんですか？",
  "en": null,
  "slots": [
   "60E9B8"
  ]
 },
 {
  "id": "21D2B8",
  "jp": "いえ…二人の食べっぷりに\nちょっと…ムネヤケが…",
  "en": null,
  "slots": [
   "60E9DC"
  ]
 },
 {
  "id": "21D28C",
  "jp": "だってアタシ、まる一日\n食べてないのヨ！",
  "en": null,
  "slots": [
   "60EA00"
  ]
 },
 {
  "id": "21D274",
  "jp": "オトメのピンチなのヨ。",
  "en": null,
  "slots": [
   "60EA24"
  ]
 },
 {
  "id": "21D24C",
  "jp": "こっちはおサイフが\nピンチですヨ！！",
  "en": null,
  "slots": [
   "60EA48"
  ]
 },
 {
  "id": "21D23C",
  "jp": "まあいいです。",
  "en": null,
  "slots": [
   "60EA90"
  ]
 },
 {
  "id": "21D214",
  "jp": "今日もあちこち\n歩きまわりますからね。",
  "en": null,
  "slots": [
   "60EAB4"
  ]
 },
 {
  "id": "21D1FC",
  "jp": "おはようございます。",
  "en": null,
  "slots": [
   "60EAD8"
  ]
 },
 {
  "id": "21D1D0",
  "jp": "食事中のところ、\nもうしわけないですけど",
  "en": null,
  "slots": [
   "60EAFC"
  ]
 },
 {
  "id": "21D198",
  "jp": "知らせたいことがあって\n来ました。\nよろしいですか？",
  "en": null,
  "slots": [
   "60EB20"
  ]
 },
 {
  "id": "21D17C",
  "jp": "お、おはようございますッ！",
  "en": null,
  "slots": [
   "60EB44"
  ]
 },
 {
  "id": "21D130",
  "jp": "朝食もスグおわりますし…\n私たちが使っている部屋で\nよろしければ…ハイッ！",
  "en": null,
  "slots": [
   "60EB68"
  ]
 },
 {
  "id": "21D110",
  "jp": "わかりました。\nでは後ほど…",
  "en": null,
  "slots": [
   "60EB8C"
  ]
 },
