  "id": "1F7194",
  "jp": "とにかく気ィつけてな！\n無事やったらまた会お。",
  "en": null,
  "slots": [
   "5DB478"
  ]
 },
 {
  "id": "1F7188",
  "jp": "またな～！",
  "en": null,
  "slots": [
   "5DB4C0"
  ]
 },
 {
  "id": "1F715C",
  "jp": "なぁにアレ。\nゲンキなお子サマだったわね。",
  "en": null,
  "slots": [
   "5DB4E4"
  ]
 },
 {
  "id": "1F7130",
  "jp": "いったい何の『仕事』で\nかせいでんだか。",
  "en": null,
  "slots": [
   "5DB508"
  ]
 },
 {
  "id": "1F7108",
  "jp": "彼なりにがんばってるんじゃ\nないかな。",
  "en": null,
  "slots": [
   "5DB52C"
  ]
 },
 {
  "id": "1F70DC",
  "jp": "それより、\nエディルレイドのことですけど…",
  "en": null,
  "slots": [
   "5DB550"
  ]
 },
 {
  "id": "1F708C",
  "jp": "ポルトガレオンの人が\nエディルレイドに悪いイメージ\nでも持ってるんでしょうか…",
  "en": null,
  "slots": [
   "5DB574"
  ]
 },
 {
  "id": "1F7044",
  "jp": "そもそもエディルレイドを\n知ってるってだけでも\nめずらしいんですが…",
  "en": null,
  "slots": [
   "5DB598"
  ]
 },
 {
  "id": "1F7004",
  "jp": "まァ、ポルトガレオンには\nアークエイルの支部も\nあることですし",
  "en": null,
  "slots": [
   "5DB5BC"
  ]
 },
 {
  "id": "1F6FD0",
  "jp": "何か情報が無いか、きくために\nよってみましょう。",
  "en": null,
  "slots": [
   "5DB5E0"
  ]
 },
 {
  "id": "1F6FB8",
  "jp": "げ、アークエイル！？",
  "en": null,
  "slots": [
   "5DB604"
  ]
 },
 {
  "id": "1F6FA8",
  "jp": "大丈夫だよ。",
  "en": null,
  "slots": [
   "5DB628"
  ]
 },
 {
  "id": "1F6F64",
  "jp": "アークエイルにレンちゃんを\n引きわたしたりしないから。\n約束する。",
  "en": null,
  "slots": [
   "5DB64C"
  ]
 },
 {
  "id": "1F6F58",
  "jp": "うう～ん…",
  "en": null,
  "slots": [
   "5DB670"
  ]
 },
 {
  "id": "1F6F4C",
  "jp": "信じるよ",
  "en": null,
  "slots": [
   "5DB694"
  ]
 },
 {
  "id": "1F6F3C",
  "jp": "ちょっと不安",
  "en": null,
  "slots": [
   "5DB6B8"
  ]
 },
 {
  "id": "1F6F0C",
  "jp": "うん。\nそうだよな。\nローとシスカなら大丈夫…",
  "en": null,
  "slots": [
   "5DB700"
  ]
 },
 {
  "id": "1F6EC8",
  "jp": "って、二人を信じたとしても\nほかのヤツラまで信じろって\n言うのか？",
  "en": null,
  "slots": [
   "5DB724"
  ]
 },
 {
  "id": "1F6EB4",
  "jp": "まかせて下さい。",
  "en": null,
  "slots": [
   "5DB748"
  ]
 },
 {
  "id": "1F6E60",
  "jp": "アークエイルのほかの方々には\nレンさんに手を出さないよう\nキツく注意しておきます。",
  "en": null,
  "slots": [
   "5DB76C"
  ]
 },
 {
  "id": "1F6E14",
  "jp": "アークエイルが保護するのは\n人間の自分勝手な行動で\n不幸な目にあっていたり",
  "en": null,
  "slots": [
   "5DB790"
  ]
 },
 {
  "id": "1F6DE4",
  "jp": "力が強すぎて危険な\nエディルレイドだけです。",
  "en": null,
  "slots": [
   "5DB7B4"
  ]
 },
 {
  "id": "1F6D9C",
  "jp": "それでもレンさんをどうこう\nしよう、なんて人がいたら\n私がこの手で…",
  "en": null,
  "slots": [
   "5DB7D8"
  ]
 },
 {
  "id": "1F6D74",
  "jp": "先輩！\nストップ！　ストップですよ！！",
  "en": null,
  "slots": [
   "5DB7FC"
  ]
 },
 {
  "id": "1F6D34",
  "jp": "先輩が手を出さなくても\n話をすればわかってくれると\n思います。",
  "en": null,
  "slots": [
   "5DB820"
  ]
 },
 {
  "id": "1F6CEC",
  "jp": "エディルレイドの話どころか\n給料へらされちゃっても\n知りませんからね…",
  "en": null,
  "slots": [
   "5DB844"
  ]
 },
 {
  "id": "1F6CC8",
  "jp": "あら………\nそ、それもそうですね。",
  "en": null,
  "slots": [
   "5DB868"
  ]
 },
 {
  "id": "1F6C80",
  "jp": "ワタクシとしたことが\nつい、力にモノ言わせて\nあばれるところでした。",
  "en": null,
  "slots": [
   "5DB88C"
  ]
 },
 {
  "id": "1F6C40",
  "jp": "とにかくクーさん。\n何度も言いますが、\n私たちを信じて下さい。",
  "en": null,
  "slots": [
   "5DB8B0"
  ]
 },
 {
  "id": "1F6C2C",
  "jp": "…別のイミで心配…",
  "en": null,
  "slots": [
   "5DB8D4"
  ]
 },
 {
  "id": "1F6BF4",
  "jp": "え？　なぜです？\n私の説明、伝わりません\nでしたか…？",
  "en": null,
  "slots": [
   "5DB8F8"
  ]
 },
 {
  "id": "1F6BAC",
  "jp": "シスカは、すぐに武器取り出して\nうったりするんじゃないかって\n心配よ。",
  "en": null,
  "slots": [
   "5DB91C"
  ]
 },
 {
  "id": "1F6B5C",
  "jp": "や…イヤですよ…\nそんなことするワケないでしょ？\nお、おほ、オホホホホホッ。",
  "en": null,
  "slots": [
   "5DB940"
  ]
 },
 {
  "id": "1F6B50",
  "jp": "コワイ。",
  "en": null,
  "slots": [
   "5DB964"
  ]
 },
 {
  "id": "1F6B40",
  "jp": "レンさんまで…",
  "en": null,
  "slots": [
   "5DB988"
  ]
 },
 {
  "id": "1F6AFC",
  "jp": "大丈夫って言っても…\nアークエイルはレンを\nつかまえたいんだろ？",
  "en": null,
  "slots": [
   "5DB9AC"
  ]
 },
 {
  "id": "1F6AB4",
  "jp": "本当のことを言いますと\nレンさんにとって、\n何が安全でイチバンなのか…",
  "en": null,
  "slots": [
   "5DB9F4"
  ]
 },
 {
  "id": "1F6A9C",
  "jp": "考えなくはないんです。",
  "en": null,
  "slots": [
   "5DBA18"
  ]
 },
 {
  "id": "1F6A58",
  "jp": "レンさんが『七煌宝樹』という\n特別なエディルレイドだと\nいうこと。",
  "en": null,
  "slots": [
   "5DBA3C"
  ]
 },
 {
  "id": "1F6A10",
  "jp": "それをねらって、レンさんを\n手に入れようとする人間は\n後をたちません。",
  "en": null,
  "slots": [
   "5DBA60"
  ]
 },
 {
  "id": "1F69CC",
  "jp": "それでも私は、レンさんを\nエディルガーデンへ\nお連れしたいんです。",
  "en": null,
  "slots": [
   "5DBA84"
  ]
 },
 {
  "id": "1F69C0",
  "jp": "シスカ…",
  "en": null,
  "slots": [
   "5DBAA8",
   "5DBCA0"
  ]
 },
 {
  "id": "1F6974",
  "jp": "まあ、シスカやローたちが\nどうがんばったって\nアークエイルの上の人たちが",
  "en": null,
  "slots": [
   "5DBACC"
  ]
 },
 {
  "id": "1F6920",
  "jp": "レンちゃんをつかまえろって\n言ったら、ほかの保護官は\nこぞってつかまえに来るわね。",
  "en": null,
  "slots": [
   "5DBAF0"
  ]
 },
 {
  "id": "1F690C",
  "jp": "そうじゃないんだ。",
  "en": null,
  "slots": [
   "5DBB14"
  ]
 },
 {
  "id": "1F68DC",
  "jp": "そういうことを言いたいんじゃ\nないんだけど…",
  "en": null,
  "slots": [
   "5DBB38"
  ]
 },
 {
  "id": "1F68A8",
  "jp": "私がいるから、クーやみんなに\n迷惑かけちゃうね。",
  "en": null,
  "slots": [
   "5DBB80"
  ]
 },
 {
  "id": "1F6874",
  "jp": "えッ！？　何言ってるんだよ。\nゼンゼンちがうって。",
  "en": null,
  "slots": [
   "5DBBA4"
  ]
 },
 {
  "id": "1F6860",
  "jp": "約束したから、さ…",
  "en": null,
  "slots": [
   "5DBBC8"
  ]
 },
 {
  "id": "1F6818",
  "jp": "エディルガーデンへ連れてって\nやれなかったらって\n考えると不安なんだ。",
  "en": null,
  "slots": [
   "5DBC10"
  ]
 },
 {
  "id": "1F67C0",
  "jp": "どんなヤツラがおそってきても\nレンのこと、ちゃんと守れるか\n悩むんだ。おかしいだろ。",
  "en": null,
  "slots": [
   "5DBC34"
  ]
 },
 {
  "id": "1F6788",
  "jp": "おかしいですッ！\nちゃんちゃらおかしいです\nクーさん！",
  "en": null,
  "slots": [
   "5DBC7C"
  ]
 },
 {
  "id": "1F6740",
  "jp": "クーさんがレンさんを守る？\nそんなのできるわけ\nないじゃないですか。",
  "en": null,
  "slots": [
   "5DBCC4"
  ]
 },
 {
  "id": "1F66FC",
  "jp": "いいですか、クーさん。\nあなたはラッキーボーイな\nだけなんです。",
  "en": null,
  "slots": [
   "5DBCE8"
  ]
 },
 {
  "id": "1F66C4",
  "jp": "レンさんと知り合えただけでも\nラッキーなんですよ！？",
  "en": null,
  "slots": [
   "5DBD0C"
  ]
 },
 {
  "id": "1F6694",
  "jp": "さぁ。\n両手をあげてよろこんで\n見せて下さい。",
  "en": null,
  "slots": [
   "5DBD30"
  ]
 },
 {
  "id": "1F6678",
  "jp": "先輩、武器はいけません…",
  "en": null,
  "slots": [
   "5DBD54"
  ]
 },
 {
  "id": "1F662C",
  "jp": "そしてレンさんのそばに\nいてあげて下さい。\nレンさんはあなただけじゃない…",
  "en": null,
  "slots": [
   "5DBD9C"
  ]
 },
 {
  "id": "1F65FC",
  "jp": "ローウェンとキーア、\nそれから私が守ります。",
  "en": null,
  "slots": [
   "5DBDC0"
  ]
 },
 {
  "id": "1F65D0",
  "jp": "必ず行きましょう。\nエディルガーデンへ。",
  "en": null,
  "slots": [
   "5DBDE4"
  ]
 },
 {
  "id": "1F65C4",
  "jp": "…シスカ…",
  "en": null,
  "slots": [
   "5DBE08"
  ]
 },
 {
  "id": "1F65A4",
  "jp": "そうだよな。\nみんなで行こう…",
  "en": null,
  "slots": [
   "5DBE2C"
  ]
 },
 {
  "id": "1F658C",
  "jp": "エディルガーデンへ。",
  "en": null,
  "slots": [
   "5DBE50"
  ]
 },
 {
  "id": "1F6570",
  "jp": "アークエイルはこわくない？",
  "en": null,
  "slots": [
   "5DBE98"
  ]
 },
 {
  "id": "1F6564",
  "jp": "どうして？",
  "en": null,
  "slots": [
   "5DBEE0"
  ]
 },
 {
  "id": "1F651C",
  "jp": "だってねらわれるのは\nレン本人じゃんか。\n本人にきくのがイチバンって…",
  "en": null,
  "slots": [
   "5DBF04"
  ]
 },
 {
  "id": "1F650C",
  "jp": "ねぇ、クー。",
  "en": null,
  "slots": [
   "5DBF4C"
  ]
 },
 {
  "id": "1F6504",
  "jp": "何？",
  "en": null,
  "slots": [
   "5DBF70"
  ]
 },
 {
  "id": "1F64D0",
  "jp": "クーは本当にシスカやローを\n信じたことがないの？",
  "en": null,
  "slots": [
   "5DBF94"
  ]
 },
 {
  "id": "1F64C8",
  "jp": "え…",
  "en": null,
  "slots": [
   "5DBFB8"
  ]
 },
 {
  "id": "1F647C",
  "jp": "私はシスカやロー、キーアが\n私とクーのために\nいろいろしてくれたと思う。",
  "en": null,
  "slots": [
   "5DBFDC"
  ]
 },
 {
  "id": "1F6448",
  "jp": "こうやって、今いっしょに\nいるのだって心強いし。",
  "en": null,
  "slots": [
   "5DC000"
  ]
 },
 {
  "id": "1F6418",
  "jp": "私たち二人だけじゃ\nできないこともきっとある。",
  "en": null,
  "slots": [
   "5DC024"
  ]
 },
 {
  "id": "1F640C",
  "jp": "だから…",
  "en": null,
  "slots": [
   "5DC048"
  ]
 },
 {
  "id": "1F6400",
  "jp": "レンさん…",
  "en": null,
  "slots": [
   "5DC06C"
  ]
 },
 {
  "id": "1F63B8",
  "jp": "そうだよな…\nヘンなこときいてごめんな。\nシスカも、ローも、キーアも。",
  "en": null,
  "slots": [
   "5DC0B4"
  ]
 },
 {
  "id": "1F638C",
  "jp": "問題なしだよ。\nみんなでがんばっていこう。",
  "en": null,
  "slots": [
   "5DC0FC"
  ]
 },
 {
  "id": "1F6358",
  "jp": "もォ、おなかがすいてんだから\n早く行きましょうよ！",
  "en": null,
  "slots": [
   "5DC120"
  ]
 },
 {
  "id": "1F6328",
  "jp": "ポルトガレオンは、もう目の前\nなんだからね！",
  "en": null,
  "slots": [
   "5DC144"
  ]
 },
 {
  "id": "1F6320",
  "jp": "ああ。",
  "en": null,
  "slots": [
   "5DC168"
  ]
 },
 {
  "id": "1F87A8",
  "jp": "それにしても…\nちっさい街にしちゃあ\n人がたくさんいそうだな。",
  "en": null,
  "slots": [
   "5DC1B0"
  ]
 },
 {
  "id": "1F8764",
  "jp": "港があるから物が集まって\n物が集まるから人が\n集まるんだろうね。",
  "en": null,
  "slots": [
   "5DC1D4"
  ]
 },
 {
  "id": "1F875C",
  "jp": "海…",
  "en": null,
  "slots": [
   "5DC1F8"
  ]
 },
 {
  "id": "1F8750",
  "jp": "ひろい…",
  "en": null,
  "slots": [
   "5DC21C"
  ]
 },
 {
  "id": "1F872C",
  "jp": "さぁって、\n食べ物はどこかしら～？",
  "en": null,
  "slots": [
   "5DC240"
  ]
 },
 {
  "id": "1F8704",
  "jp": "キーアはホント\n食べることばっかだな。",
  "en": null,
  "slots": [
   "5DC264"
  ]
 },
 {
  "id": "1F86EC",
  "jp": "何をおっしゃいます。",
  "en": null,
  "slots": [
   "5DC288"
  ]
 },
 {
  "id": "1F86B8",
  "jp": "食べ物が気になるのは\nキーアだけではないですよ。",
  "en": null,
  "slots": [
   "5DC2AC"
  ]
 },
 {
  "id": "1F8670",
  "jp": "はじめて来た場所で\nいったい何がおいしいのか。\nそれが観光の楽しみッ！",
  "en": null,
  "slots": [
   "5DC2D0"
  ]
 },
 {
  "id": "1F8630",
  "jp": "あッ！　あそこおいしそうな\n煙が出てる！！\n早く食べた～い！",
  "en": null,
  "slots": [
   "5DC2F4"
  ]
 },
 {
  "id": "1F85DC",
  "jp": "どこ、どこですかッ！？\nああ～私、がまんできません…\nスイーツを！　スイーツを！！",
  "en": null,
  "slots": [
   "5DC318"
  ]
 },
 {
  "id": "1F85B8",
  "jp": "待って下さい、先輩！\nキーアも！",
  "en": null,
  "slots": [
   "5DC33C"
  ]
 }
]
