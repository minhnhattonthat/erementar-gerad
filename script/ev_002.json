  "slots": [
   "5DC5A0"
  ]
 },
 {
  "id": "1F82D4",
  "jp": "そうですねぇ…",
  "en": null,
  "slots": [
   "5DC5C4",
   "5DCE58"
  ]
 },
 {
  "id": "1F8298",
  "jp": "ヘタに街を歩かれると\n迷子になってしまいそう\nですから…",
  "en": null,
  "slots": [
   "5DC5E8"
  ]
 },
 {
