[
 {
  "id": "1F855C",
  "jp": "食べることだけじゃなくて\n宿の手配とか、アークエイル支部\nへ行くとかあるじゃないですか！",
  "en": null,
  "slots": [
   "5DC360"
  ]
 },
 {
  "id": "1F8554",
  "jp": "うぐ…",
  "en": null,
  "slots": [
   "5DC384"
  ]
 },
 {
  "id": "1F8540",
  "jp": "…そ、そうですね…",
  "en": null,
  "slots": [
   "5DC3A8"
  ]
 },
 {
  "id": "1F8508",
  "jp": "では、用事を早く\nすませるために\n別行動しましょう。",
  "en": null,
  "slots": [
   "5DC3CC"
  ]
 },
 {
  "id": "1F84C0",
  "jp": "ごはんのおいしい宿の手配\nそれとアークエイル支部へ\n行くこととわけて…",
  "en": null,
  "slots": [
   "5DC3F0"
  ]
 },
 {
  "id": "1F8494",
  "jp": "街のまんなかにある\n広場に集合すること。",
  "en": null,
  "slots": [
   "5DC414"
  ]
 },
 {
  "id": "1F8478",
  "jp": "そんな感じでどうでしょう？",
  "en": null,
  "slots": [
   "5DC438"
  ]
 },
 {
  "id": "1F8460",
  "jp": "アタシッ！　宿の手配！",
