  "slots": [
   "5F70D8",
   "5F71D4",
   "5F72D0"
  ]
 },
 {
  "id": "20C2E0",
  "jp": "港の間かな。",
  "en": null,
  "slots": [
   "5F70FC",
   "5F71F8",
   "5F72F4"
  ]
 },
 {
  "id": "20C2C8",
  "jp": "バザーの間だと思うぜ。",
  "en": null,
  "slots": [
   "5F7120",
   "5F721C",
   "5F7318"
  ]
 },
 {
  "id": "20C2AC",
  "jp": "はね橋の入り口…かなぁ。",
  "en": null,
  "slots": [
   "5F7144",
   "5F7240",
   "5F733C"
  ]
 },
 {
  "id": "20C29C",
  "jp": "街の入り口と…",
  "en": null,
  "slots": [
   "5F7168"
  ]
 },
 {
  "id": "20C290",
  "jp": "広場と…",
  "en": null,
  "slots": [
   "5F7264"
  ]
 },
 {
  "id": "20C280",
  "jp": "そうですね。",
  "en": null,
  "slots": [
   "5F7360"
  ]
 },
 {
  "id": "20C234",
  "jp": "おじーさんとおばーちゃまの\nお話からすると\nそこがいちばんアヤシイです。",
  "en": null,
  "slots": [
   "5F7384"
  ]
 },
 {
  "id": "20C214",
  "jp": "じゃあそこへ行ってみますか。",
  "en": null,
  "slots": [
   "5F73A8"
  ]
 },
 {
  "id": "20C1F4",
  "jp": "準備をととのえて行きましょう。",
  "en": null,
  "slots": [
   "5F73CC"
  ]
 },
 {
  "id": "20C1A8",
  "jp": "広場か港、どちらがわからでも\nかまいません。\n彼らをとっつかまえましょう。",
  "en": null,
  "slots": [
   "5F73F0"
  ]
 },
 {
  "id": "20C188",
  "jp": "あなたのプレジャーさんもね。",
  "en": null,
  "slots": [
   "5F7414",
   "5F7534"
  ]
 },
 {
  "id": "20C174",
  "jp": "よろしくなのヨ。",
  "en": null,
  "slots": [
   "5F7438",
   "5F7558",
   "5F76E4"
  ]
 },
 {
  "id": "20C120",
  "jp": "ちょっとちがったようですが…\nおじーさんとおばーちゃまから\nきいたお話から考えて",
  "en": null,
  "slots": [
   "5F7480"
  ]
 },
 {
  "id": "20C100",
  "jp": "どの道か、わり出して下さいね。",
  "en": null,
  "slots": [
   "5F74A4"
  ]
 },
 {
  "id": "20C0B0",
  "jp": "一つはあってるから\nまちがってるのがどっちなのか\n思い出さなきゃいけないね。",
  "en": null,
  "slots": [
   "5F74C8"
  ]
 },
 {
  "id": "20C088",
  "jp": "さあ、準備をととのえて\n行きますよ！",
  "en": null,
  "slots": [
   "5F74EC"
  ]
 },
 {
  "id": "20C068",
  "jp": "彼らをとっつかまえましょう。",
  "en": null,
  "slots": [
   "5F7510"
  ]
 },
 {
  "id": "20C050",
  "jp": "…ぜんぜんダメです…。",
  "en": null,
  "slots": [
   "5F75A0"
  ]
 },
 {
  "id": "20C024",
  "jp": "クーさんは街の中で\n何をきいてたんですか。",
  "en": null,
  "slots": [
   "5F75C4"
  ]
 },
 {
  "id": "20C018",
  "jp": "何をって…",
  "en": null,
  "slots": [
   "5F75E8"
  ]
 },
 {
  "id": "20BFE8",
  "jp": "行き当たりばったりで\n行くことにしましょう。",
  "en": null,
  "slots": [
   "5F760C"
  ]
 },
 {
  "id": "20BFD0",
  "jp": "さ、準備して下さい。",
  "en": null,
  "slots": [
   "5F7630"
  ]
 },
 {
  "id": "20BFC0",
  "jp": "まあまあ先輩。",
  "en": null,
  "slots": [
   "5F7654"
  ]
 },
 {
  "id": "20BF84",
  "jp": "そんなに広い街でもありません。\n簡単に見つかりますって。",
  "en": null,
  "slots": [
   "5F7678"
  ]
 },
 {
  "id": "20BF34",
  "jp": "逃げられたらどうするんです！？\n彼らをとっつかまえて\nいろいろきき出さないと…",
  "en": null,
  "slots": [
   "5F769C"
  ]
 },
 {
  "id": "20BEE8",
  "jp": "それから、チルルさんの\nプレジャーさんにも\n目をさましていただかないとね。",
  "en": null,
  "slots": [
   "5F76C0"
  ]
 },
 {
  "id": "20D47C",
  "jp": "宿のまわりを\nアークエイルのかたがたが\n見まわって下さっているのが",
  "en": null,
  "slots": [
   "5F7750"
  ]
 },
 {
  "id": "20D454",
  "jp": "私たちが宿にいるように\n見えますね…",
  "en": null,
  "slots": [
   "5F7774"
  ]
 },
 {
  "id": "20D424",
  "jp": "カモフラージュ、といった\nところでしょうか。",
  "en": null,
  "slots": [
   "5F7798"
  ]
 },
 {
  "id": "20D3DC",
  "jp": "これだけ人目が多ければ\n宿をおそおう、なんて気にも\nならないでしょう。",
  "en": null,
  "slots": [
   "5F77BC"
  ]
 },
 {
  "id": "20D3B0",
  "jp": "さ、私たちから\n彼らを探しに行きましょう。",
  "en": null,
  "slots": [
   "5F77E0"
  ]
 },
