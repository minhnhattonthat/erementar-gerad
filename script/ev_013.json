  "jp": "広場",
  "en": null,
  "slots": [
   "5F7048"
  ]
 },
 {
  "id": "20C30C",
  "jp": "アークエイル支部と…",
  "en": null,
  "slots": [
   "5F706C"
  ]
 },
 {
  "id": "20C308",
