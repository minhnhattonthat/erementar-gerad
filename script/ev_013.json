[
 {
  "id": "20CDE0",
  "jp": "ここからがショウネンバです。\nみなさんも気を引きしめて\nとりかかって下さい。",
  "en": null,
  "slots": [
   "5F6694"
  ]
 },
 {
  "id": "20CDC0",
  "jp": "何だよ、そんなあらたまって。",
  "en": null,
  "slots": [
   "5F66B8"
  ]
 },
 {
  "id": "20CDA4",
  "jp": "いいですか？　クーさん。",
  "en": null,
  "slots": [
   "5F66DC"
  ]
 },
 {
  "id": "20CD74",
  "jp": "昨日の夜を思い出して下さい。\nおぼえてますか？",
  "en": null,
  "slots": [
   "5F6700"
  ]
 },
 {
  "id": "20CD60",
  "jp": "おぼえてるかって…",
  "en": null,
  "slots": [
   "5F6724"
  ]
 },
 {
  "id": "20CD40",
  "jp": "何ッ！\nリアクトが…とけた。",
  "en": null,
  "slots": [
   "5F6748"
  ]
 },
 {
  "id": "20CD24",
  "jp": "レン。もっかいリアクトだ！",
  "en": null,
  "slots": [
   "5F676C"
  ]
 },
 {
  "id": "20CD08",
  "jp": "『あかかる　こ…こころ…』",
  "en": null,
  "slots": [
   "5F6790"
  ]
 },
 {
  "id": "20CCEC",
  "jp": "『……か……かぜ…………』",
  "en": null,
  "slots": [
   "5F67B4"
  ]
 },
 {
  "id": "20CCE0",
  "jp": "……あれ？",
  "en": null,
  "slots": [
   "5F67D8"
  ]
 },
 {
  "id": "20CCA4",
  "jp": "どうしよう…\n謳をうたおうとすると\n謳がどっか消えちゃう。",
  "en": null,
  "slots": [
   "5F6820"
  ]
 },
 {
  "id": "20CC94",
  "jp": "何だって！？",
  "en": null,
  "slots": [
   "5F6844"
  ]
 },
 {
  "id": "20CC70",
  "jp": "…さっきの…謳のせいか？\nくそッ！",
  "en": null,
  "slots": [
   "5F688C"
  ]
 },
 {
  "id": "20CC48",
  "jp": "お前たちはリアクト\nできなくなった。",
  "en": null,
  "slots": [
   "5F68B0"
  ]
 },
 {
  "id": "20CC08",
  "jp": "リアクトできない\nエディルレイドなど\n武器としても使えない。",
  "en": null,
  "slots": [
   "5F68D4"
  ]
 },
 {
  "id": "20CBEC",
  "jp": "さあ、おとなしくわたせ！",
  "en": null,
  "slots": [
   "5F68F8"
  ]
 },
 {
  "id": "20CBAC",
  "jp": "黒い集団におそわれて、\n俺とレンがリアクト\nできなくなった。",
  "en": null,
  "slots": [
   "5F6940"
  ]
 },
 {
  "id": "20CB60",
  "jp": "そうです。その後も\nこうやって宿にいる私たちを\nとりかこむように集まって…",
  "en": null,
  "slots": [
   "5F6964"
  ]
 },
 {
  "id": "20CB30",
  "jp": "何とかアークエイル支部まで\n逃げたんだよな。",
  "en": null,
  "slots": [
   "5F6988"
  ]
 },
 {
  "id": "20CB18",
  "jp": "しっかりおぼえてるぜ。",
  "en": null,
  "slots": [
   "5F69AC"
  ]
 },
 {
  "id": "20CAC8",
  "jp": "アークエイルから今夜\nこの宿のまわりを見まわる\n何人かが来ることになってます。",
  "en": null,
  "slots": [
   "5F69D0"
  ]
 },
 {
  "id": "20CA80",
  "jp": "宿にいればおそらく\n黒集団がこの宿に\nあらわれることはないでしょう。",
  "en": null,
  "slots": [
   "5F69F4"
  ]
 },
 {
  "id": "20CA50",
  "jp": "だからと言って何もせず\n待つことはしません。",
  "en": null,
  "slots": [
   "5F6A18"
  ]
 },
 {
  "id": "20CA24",
  "jp": "そんな、せっかく\n見まわりをたのんだのに…",
  "en": null,
  "slots": [
   "5F6A3C"
  ]
 },
 {
  "id": "20CA14",
  "jp": "ローウェン！",
  "en": null,
  "slots": [
   "5F6A60"
  ]
 },
 {
  "id": "20CA00",
  "jp": "はっ……ハイ……",
  "en": null,
  "slots": [
   "5F6A84"
  ]
 },
 {
  "id": "20C9C0",
  "jp": "あなたなりに、敵について\n知っている情報を\nまとめてみなさい。",
  "en": null,
  "slots": [
   "5F6AA8"
  ]
 },
 {
  "id": "20C9A0",
  "jp": "ええッ！？　いきなりですか？",
  "en": null,
  "slots": [
   "5F6ACC"
  ]
 },
 {
  "id": "20C990",
  "jp": "ローウェン？",
  "en": null,
  "slots": [
   "5F6AF0"
  ]
 },
 {
  "id": "20C984",
  "jp": "ハイッ！",
  "en": null,
  "slots": [
   "5F6B14"
  ]
 },
 {
  "id": "20C978",
  "jp": "えっと…",
  "en": null,
  "slots": [
   "5F6B38"
  ]
 },
 {
  "id": "20C924",
  "jp": "彼らは人の目にふれないよう\n夜、バザーや港など、少しでも\n人がいるトコロではなく",
  "en": null,
  "slots": [
   "5F6B5C"
  ]
 },
 {
  "id": "20C8F0",
  "jp": "その間をつなぐ、人目の無い\n夜道にあらわれます。",
  "en": null,
  "slots": [
   "5F6B80"
  ]
 },
 {
  "id": "20C8E4",
  "jp": "そうです。",
  "en": null,
  "slots": [
   "5F6BA4"
  ]
 },
 {
  "id": "20C8AC",
  "jp": "それをぎゃくに、私たちが\n待ちぶせできないでしょうか。",
  "en": null,
  "slots": [
   "5F6BC8"
  ]
 },
 {
  "id": "20C89C",
  "jp": "待ちぶせ！？",
  "en": null,
  "slots": [
   "5F6BEC"
  ]
 },
 {
  "id": "20C84C",
  "jp": "彼らが夜道でしかおそって\n来ないなら、彼らがいる\n夜道へ行くってことですか？",
  "en": null,
  "slots": [
   "5F6C10"
  ]
 },
 {
  "id": "20C7F8",
  "jp": "彼らが今夜、われわれではない\nエディルレイドプレジャーを\nねらう可能性があります。",
  "en": null,
  "slots": [
   "5F6C34"
  ]
 },
 {
  "id": "20C7B4",
  "jp": "そこをたたき、かつ\n彼らが何者であるかを\nつかむことができれば…",
  "en": null,
  "slots": [
   "5F6C58"
  ]
 },
 {
  "id": "20C7A4",
  "jp": "何か問題は？",
  "en": null,
  "slots": [
   "5F6C7C"
  ]
 },
 {
  "id": "20C75C",
  "jp": "謳をうたえなくする謳は、\nクーとレンちゃんは\n特訓をしたから問題ないし",
  "en": null,
  "slots": [
   "5F6CA0"
  ]
 },
 {
  "id": "20C724",
  "jp": "僕とキーアも、かかったとしても\n大丈夫だと思います。",
  "en": null,
  "slots": [
   "5F6CC4"
  ]
 },
 {
  "id": "20C6E8",
  "jp": "アークエイルで、いつもやってる\n特訓が、よかったみたいね。",
  "en": null,
  "slots": [
   "5F6CE8"
  ]
 },
 {
  "id": "20C6B4",
  "jp": "気になるのは黒い集団と\nいっしょにいる彼のこと。",
  "en": null,
  "slots": [
   "5F6D30"
  ]
 },
 {
  "id": "20C68C",
  "jp": "エディルレイドハンター\nヴォルクス…",
  "en": null,
  "slots": [
   "5F6D54"
  ]
 },
 {
  "id": "20C65C",
  "jp": "チルルさんの話では\n彼はあやつられている、と。",
  "en": null,
  "slots": [
   "5F6D78"
  ]
 },
 {
  "id": "20C644",
  "jp": "そうヨ！　その通りヨ！",
  "en": null,
  "slots": [
   "5F6D9C"
  ]
 },
 {
  "id": "20C600",
  "jp": "ヴォル君はあんな\nヒキョーなヤツラの\n手下なんかしない人なのヨ！",
  "en": null,
  "slots": [
   "5F6DC0"
  ]
 },
 {
  "id": "20C5C4",
  "jp": "リアクトできなくなった謳とは\nちがう謳だと言ってましたね。",
  "en": null,
  "slots": [
   "5F6DE4"
  ]
 },
 {
  "id": "20C590",
  "jp": "そうよ…あれはヴォル君に\nむけられた謳だったのヨ！",
  "en": null,
  "slots": [
   "5F6E08"
  ]
 },
 {
  "id": "20C550",
  "jp": "ヴォル君が謳でヘンに\nなっちゃって、\nアタシに『どけ』って…",
  "en": null,
  "slots": [
   "5F6E2C"
  ]
 },
 {
  "id": "20C52C",
  "jp": "ひどい…ひどいのヨ\nヴォルくん…",
  "en": null,
  "slots": [
   "5F6E50"
  ]
 },
 {
  "id": "20C514",
  "jp": "ダーイジョーブだって。",
  "en": null,
  "slots": [
   "5F6E74"
  ]
 },
 {
  "id": "20C4D8",
  "jp": "謳の力が無くなれば\nもとのステキな彼に\nもどるはずだから。",
  "en": null,
  "slots": [
   "5F6E98"
  ]
 },
 {
  "id": "20C4CC",
  "jp": "…うん…",
  "en": null,
  "slots": [
   "5F6EBC"
  ]
 },
 {
  "id": "20C48C",
  "jp": "その二つの謳は\nエディルレイドが\n一人でうたってるのかしら。",
  "en": null,
  "slots": [
   "5F6EE0"
  ]
 },
 {
  "id": "20C464",
  "jp": "それにしては、こうげき的な\n謳よね…",
  "en": null,
  "slots": [
   "5F6F04"
  ]
 },
 {
  "id": "20C424",
  "jp": "謳がうたえるエディルレイドと\nそのプレジャーがいるってこと？",
  "en": null,
  "slots": [
   "5F6F28"
  ]
 },
 {
  "id": "20C3F8",
  "jp": "エディルレイドがいれば\nプレジャーがいる。",
  "en": null,
  "slots": [
   "5F6F4C"
  ]
 },
 {
  "id": "20C3CC",
  "jp": "かならずしも、そうとは\n言いきれませんが",
  "en": null,
  "slots": [
   "5F6F70"
  ]
 },
 {
  "id": "20C3AC",
  "jp": "気をつけたほうがいいでしょう。",
  "en": null,
  "slots": [
   "5F6F94"
  ]
 },
 {
  "id": "20C374",
  "jp": "しかし、待ちぶせと言っても\nこの街のどこにいるのか…",
  "en": null,
  "slots": [
   "5F6FB8"
  ]
 },
 {
  "id": "20C34C",
  "jp": "クーは、どことどこの間の\n道だと思う？",
  "en": null,
  "slots": [
   "5F6FDC"
  ]
 },
 {
  "id": "20C338",
  "jp": "アークエイル支部",
  "en": null,
  "slots": [
   "5F7000"
  ]
 },
 {
  "id": "20C32C",
  "jp": "街の入り口",
  "en": null,
  "slots": [
   "5F7024"
  ]
 },
 {
